    must have killed a lot of demons.","_text_jp":"\u305f\u304f\u3055\u3093\u9b54\u65cf\u3092\u5012\u3057\u305f\u3093\u3067\u3057\u3087\uff1f"},"_actorName":"\u53e4\u838e","_actorParameterID":"0fa811bc-8f42-4cf7-9d8f-fb1b93925a6a","_position":{"x":200.0,"y":6220.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"57"},{"FaceType":{"_value":7},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u55ef\uff0c\u90a3\u5e74\u6211\u548c\u59b9\u59b9\u5dee\u70b9\u6b7b\u5728\u4fb5\u7565\u519b\u624b\u91cc\uff0c\u662f\u4ed6\u628a\u6211\u4eec\u6551\u4e86\u4e0b\u6765\u3002","_text_en":"Yes.
    That year, my sister and I almost died in the enemy raid. He was the one who
    saved us.","_text_jp":"\u3046\u3093\u3002\u3042\u306e\u5e74\u3001\u79c1\u3068\u59b9\u306f\u4fb5\u7565\u8ecd\u306b\u6bba\u3055\u308c\u304b\u3051\u305f\u306e\u3092\u3001\u5f7c\u304c\u52a9\u3051\u3066\u304f\u308c\u305f\u306e\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"6a7cfaae-79d0-4d87-ab08-bad232765847","_position":{"x":201.0,"y":6340.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"58"},{"FaceType":{"_value":29},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u53e4\u838e","_actorParameterID":"0fa811bc-8f42-4cf7-9d8f-fb1b93925a6a","_position":{"x":200.0,"y":6460.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"59"},{"FaceType":{"_value":5},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u53e4\u838e\uff1f","_text_en":"Gusha?","_text_jp":"\u30b0\u30fc\u30b7\u30e3\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"6a7cfaae-79d0-4d87-ab08-bad232765847","_position":{"x":200.0,"y":6580.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"60"},{"FaceType":{"_value":6},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u554a\u3002\u5feb\u5230\u6751\u957f\u5bb6\u95e8\u53e3\u4e86\u3002","_text_en":"Ah\u2026
