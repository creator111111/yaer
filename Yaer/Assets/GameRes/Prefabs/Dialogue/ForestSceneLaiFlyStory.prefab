    My daughter is strong, isn\u2019t she?","_text_jp":"\u3069\u3046\u3060\u3001\u6211\u304c\u5a18\u306f\u5f37\u3044\u3060\u308d\u3046\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":470.6834,"y":224.2804},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":12},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":523.6834,"y":314.2804},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u8fd8\u5728\u6028\u6211\u5417\uff1f","_text_en":"You
    still resent me, don\u2019t you?","_text_jp":"\u307e\u3060\u4ffa\u3092\u6068\u3093\u3067\u3044\u308b\u304b\uff1f"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":464.6834,"y":407.2804},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{"_value":12},"statement":{"_text":"\u6211\u5e76\u975e\u6028\u4f60\uff0c\u6211\u53ea\u662f\u5e0c\u671b\u4f60\u80fd\u6709\u4f60\u5973\u513f\u7684\u575a\u5f3a\u3002","_text_en":"
    It''s not resentment I hold toward you \u2014 I just wish you had your daughter''s
    strength.","_text_jp":"\u6068\u3093\u3067\u3044\u308b\u308f\u3051\u3067\u306f\u306a\u3044\u3002\u305f\u3060\u304a\u524d\u306b\u3082\u5a18\u306e\u3088\u3046\u306a\u5f37\u3055\u3092\u6301\u3063\u3066\u307b\u3057\u3044\u3068\u601d\u3063\u3066\u3044\u308b\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":379.6834,"y":507.2804},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{"_value":11},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":456.0,"y":619.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"FaceType":{"_value":12},"statement":{"_text":"\u4f60\u548c\u5f53\u5e74\u771f\u662f\u5929\u5dee\u5730\u522b\u3002","_text_en":"You\u2019re
    nothing like the man you used to be.","_text_jp":"\u6614\u306e\u3042\u3093\u305f\u3068\u306f\u5168\u7136\u9055\u3046\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":424.6834,"y":707.2804},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"13"},{"FaceType":{"_value":11},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":443.0,"y":794.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"14"},{"FaceType":{"_value":11},"statement":{"_text":"\u51ef\uff0c\u5df2\u7ecf\u516b\u5e74\u4e86\uff0c\u5979\u4e0d\u4f1a\u56de\u6765\u4e86\u3002","_text_en":"Kai,
    it\u2019s been eight years. She\u2019s not coming back.","_text_jp":"\u30b1\u30a4\u3001\u3082\u3046\u516b\u5e74\u3060\u3001\u5f7c\u5973\u306f\u5e30\u3063\u3066\u3053\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":377.6834,"y":880.2804},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"15"},{"FaceType":{"_value":11},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":431.0,"y":988.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"16"},{"FaceType":{"_value":11},"statement":{"_text":"\u6bcf\u5f53\u6211\u770b\u5230\u4f60\u8fd9\u4e2a\u6837\u5b50\uff0c\u6211\u5c31\u5728\u60f3\u8fd9\u4e00\u5207\u5230\u5e95\u503c\u4e0d\u503c\u3002","_text_en":"Every
    time I see you like this, I can\u2019t help but wonder was it all worth it?","_text_jp":"\u304a\u524d\u304c\u3042\u3042\u3044\u3046\u59ff\u3092\u898b\u308b\u305f\u3073\u306b\u3001\u3053\u308c\u304c\u610f\u5473\u306e\u3042\u308b\u3053\u3068\u306a\u306e\u304b\u8003\u3048\u308b\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":316.6834,"y":1092.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"17"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u8fd8\u6253\u7b97\u85cf\u5728\u9ed1\u6697\u91cc\u591a\u4e45\uff0c\u4f60\u60f3\u8ba9\u4f60\u5973\u513f\u4eec\u5c31\u770b\u7740\u4f60\u8fd9\u4e2a\u5fb7\u884c\u957f\u5927?","_text_en":"How
    long do you intend to hide in the dark?Do you want your daughters to grow up
    watching you like this?\"","_text_jp":"\u3044\u3064\u307e\u3067\u95c7\u306b\u96a0\u308c\u3066\u3044\u308b\u3064\u3082\u308a\u3060\uff1f\u5a18\u305f\u3061\u306b\u3042\u3093\u306a\u59ff\u3092\u898b\u305b\u3066\u80b2\u3066\u305f\u3044\u306e\u304b\uff1f"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":332.6834,"y":1200.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"18"},{"FaceType":{"_value":15},"statement":{"_text":"\u4f60\u8fd8\u8981\u7b49\u591a\u4e45\uff0c\u4f60\u8fd8\u8981\u6211\u4eec\u7b49\u4f60\u591a\u4e45\uff01","_text_en":"How
    much longer do you expect us to wait?!","_text_jp":"\u3044\u3064\u307e\u3067\u5f85\u305f\u305b\u308b\u3093\u3060\uff1f\u4ffa\u305f\u3061\u3092\u3069\u308c\u3060\u3051\u5f85\u305f\u305b\u308b\u3064\u3082\u308a\u3060\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":390.6834,"y":1293.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"19"},{"FaceType":{"_value":15},"statement":{"_text":"\u4f60\u73b0\u5728\u8fd9\u4e2a\u5fb7\u884c\uff01\u8fd8\u80fd\u9886\u5bfc\u6211\u4eec\u6253\u56de\u53bb\u4e48\uff01","_text_en":"Look
    at you now! You think you can still lead us back into battle like this?","_text_jp":"\u4eca\u306e\u304a\u524d\u306e\u72b6\u614b\u3067\u6211\u3005\u3092\u7387\u3044\u3066\u6226\u3048\u308b\u306e\u304b\uff1f"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":388.6834,"y":1388.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"20"},{"FaceType":{"_value":15},"statement":{"_text":"\u5979\u5df2\u7ecf\u6b7b\u4e86\uff01\u56de\u4e0d\u6765\u4e86\uff01\u4f60\u6e05\u9192\u70b9\uff01\uff01\uff01","_text_en":"She\u2019s
    dead! She\u2019s not coming back! Wake up!","_text_jp":"\u5f7c\u5973\u306f\u3082\u3046\u6b7b\u3093\u3060\u3093\u3060\uff01\u623b\u3063\u3066\u3053\u306a\u3044\u3093\u3060\uff01\u3057\u3063\u304b\u308a\u3057\u308d\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":389.6834,"y":1488.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"21"},{"FaceType":{"_value":15},"statement":{"_text":"\u770b\u770b\u8fd9\u4e9b\u4eba\uff01\u4ed6\u4eec\u5728\u90fd\u5728\u7b49\u4f60\u4e0b\u4ee4\uff01","_text_en":"Look
    at these people! They\u2019re all waiting for your command!","_text_jp":"\u3053\u306e\u5175\u58eb\u305f\u3061\u3092\u898b\u308d\uff01\u307f\u3093\u306a\u304a\u524d\u306e\u547d\u4ee4\u3092\u5f85\u3063\u3066\u3044\u308b\u3093\u3060\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":389.6834,"y":1578.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"22"},{"FaceType":{"_value":15},"statement":{"_text":"\u5979\u6b7b\u4e86\uff01\u80fd\u542c\u89c1\u4e48\uff01","_text_en":"She\u2019s
    dead! Do you hear me?!","_text_jp":"\u5f7c\u5973\u306f\u6b7b\u3093\u3060\u3093\u3060\uff01\u805e\u3053\u3048\u3066\u3044\u308b\u304b\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":440.6834,"y":1665.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"23"},{"FaceType":{"_value":2},"statement":{"_text":"\u95ed\u5634!","_text_en":"Enough!","_text_jp":"\u9ed9\u308c\uff01"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":466.6834,"y":1760.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"24"},{"FaceType":{"_value":2},"statement":{"_text":"\u4f60\u8fd9\u4e48\u60b2\u89c2\uff0c\u4e3a\u4ec0\u4e48\u8fd8\u8ddf\u7740\u6211\u3002","_text_en":"You\u2019re
    so pessimistic, why are you still following me?","_text_jp":"\u304a\u524d\u306f\u305d\u3093\u306a\u306b\u60b2\u89b3\u7684\u306a\u306e\u306b\u3001\u306a\u305c\u4ffa\u306b\u3064\u3044\u3066\u304f\u308b\uff1f"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":421.6834,"y":1867.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"25"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u8bdd\u91cd\u4e86\uff0c\u62b1\u6b49\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"That
    was harsh of me... I apologize.","_text_jp":"\u8a00\u8449\u304c\u904e\u304e\u305f\u3001\u3059\u307e\u306a\u3044\u2026"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":408.6834,"y":1956.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"26"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u4eec\u4e00\u8d77\u7ecf\u5386\u4e86\u5f88\u591a\u3002","_text_en":"We\u2019ve
    been through so much together.","_text_jp":"\u5171\u306b\u591a\u304f\u3092\u7d4c\u9a13\u3057\u3066\u304d\u305f\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":408.6834,"y":2053.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"27"},{"FaceType":{"_value":11},"statement":{"_text":"\u4ece\u83b1\u7533\u74e6\u5230\u5fb7\u52d2\u65af\u4e1c\uff0c\u6211\u4eec\u4e00\u8def\u5f81\u6218\u81f3\u4eca\uff0c\u6b20\u4f60\u7684\uff0c\u4e5f\u8be5\u8fd8\u6e05\u4e86\u3002","_text_en":"From
    Raishenwa to Dreston, we\u2019ve fought side by side all the way.I no longer
    owe you anything.","_text_jp":"\u30e9\u30a4\u30b7\u30a7\u30f3\u30f4\u30a1\u304b\u3089\u30c7\u30ec\u30b9\u30c9\u30f3\u307e\u3067\u3001\u5171\u306b\u6226\u3044\u7d9a\u3051\u305f\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":274.6834,"y":2150.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"28"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u5b9e\u5728\u4e0d\u613f\u89c1\u4f60\u5982\u6b64\u3002","_text_en":"It\u2019s
    time I repaid what I owe you.","_text_jp":"\u304a\u524d\u304c\u3053\u3046\u306a\u308b\u306e\u306f\u898b\u305f\u304f\u306a\u304b\u3063\u305f\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":381.6834,"y":2249.28},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"29"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u4e0d\u5f97\u4e0d\u627f\u8ba4\uff0c\u5f53\u5e74\u7684\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"I
    must admit\u2026 back then\u2026","_text_jp":"\u8a8d\u3081\u3056\u308b\u3092\u5f97\u306a\u3044\u3001\u3042\u306e\u6642\u306f\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":353.3438,"y":2365.557},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"30"},{"FaceType":{"_value":15},"statement":{"_text":"\u90a3\u4e0d\u662f\u4f60\u7684\u9519\uff01","_text_en":"It
    wasn\u2019t your fault!","_text_jp":"\u305d\u308c\u306f\u304a\u524d\u306e\u305b\u3044\u3058\u3083\u306a\u3044\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":399.6666,"y":2461.366},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"31"},{"FaceType":{"_value":15},"statement":{"_text":"\u8c01\u90fd\u6ca1\u6599\u5230\uff01","_text_en":"No
    one could have predicted it!","_text_jp":"\u8ab0\u3082\u4e88\u60f3\u3067\u304d\u306a\u304b\u3063\u305f\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":413.6477,"y":2554.389},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"32"},{"FaceType":{"_value":2},"statement":{"_text":"\u53ef\u5982\u679c\u6211\u4eec\u518d\u665a\u56de\u6765\u4e00\u4f1a\uff01","_text_en":"But
    if we had returned even a moment later\uff01","_text_jp":"\u3060\u304c\u3001\u3082\u3057\u3082\u3046\u5c11\u3057\u9045\u308c\u3066\u3044\u305f\u3089\uff01"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":372.3275,"y":2644.677},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"33"},{"FaceType":{"_value":11},"statement":{"_text":"\u53ea\u6015\u662f\u3002\u3002\u3002\u3002\u3002","_text_en":"It
    could have been\u2026","_text_jp":"\u6050\u3089\u304f\u306f\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":373.3017,"y":2734.698},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"34"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"I\u2026","_text_jp":"\u4ffa\u306f\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":393.2859,"y":2835.725},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"35"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u4e0d\u60f3\u518d\u5931\u53bb\u66f4\u591a\u4e86\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"I
    don\u2019t want to lose anyone else\u2026","_text_jp":"\u3053\u308c\u4ee5\u4e0a\u5931\u3044\u305f\u304f\u306a\u3044\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":351.5343,"y":2932.644},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"36"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u5f81\u6218\u4e00\u751f\uff0c\u53ea\u4e3a\u4e86\u65cf\u4eba\u80fd\u5b89\u5c45\u4e50\u4e1a\uff0c\u5230\u5934\u6765\u8fd9\u4e2a\u5c40\u9762\u3002","_text_en":"I\u2019ve
    fought all my life, just so our people could live in peace. In the end, this
    is what became of it all.","_text_jp":"\u4e00\u751f\u3092\u6226\u306b\u8cbb\u3084\u3057\u305f\u3002\u65cf\u304c\u5b89\u3089\u304b\u306b\u66ae\u3089\u305b\u308b\u305f\u3081\u306b\u3002\u3057\u304b\u3057\u3053\u306e\u7d50\u679c\u3060\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":295.1859,"y":3037.904},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"37"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u6211\u8001\u4e86\uff0c\u53ef\u6218\u4e89\u8fd8\u5728\u6301\u7eed\uff0c\u8fd9\u573a\u6218\u4e89\u8fd8\u8981\u6301\u7eed\u591a\u4e45\u3002","_text_en":"We\u2019ve
    grown old, and the war still rages on\uff0cHow long must this war drag on?","_text_jp":"\u4ffa\u305f\u3061\u306f\u5e74\u3092\u3068\u3063\u305f\u304c\u3001\u6226\u4e89\u306f\u7d9a\u3044\u3066\u3044\u308b\u3002\u3053\u306e\u6226\u4e89\u306f\u3044\u3064\u7d42\u308f\u308b\u306e\u304b\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":281.5854,"y":3137.95},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"38"},{"FaceType":{"_value":11},"statement":{"_text":"\u597d\u50cf\u8fd9\u4e00\u8f88\u5b50\u767d\u5fd9\u3002","_text_en":"It
    feels like a lifetime wasted.","_text_jp":"\u307e\u308b\u3067\u4e00\u751f\u7121\u99c4\u306b\u3057\u305f\u3088\u3046\u3060\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":379.5464,"y":3252.594},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"39"},{"FaceType":{"_value":15},"statement":{"_text":"\u6211\u8ddf\u7740\u4f60\u662f\u56e0\u4e3a\u6211\u4fe1\u4f60\uff0c\u6211\u4e5f\u4e00\u76f4\u76f8\u4fe1\uff0c\u76f4\u5230\u6211\u4eec\u90fd\u5012\u4e0b\u90a3\u5929\uff0c\u6211\u5e0c\u671b\u4f60\u9886\u5bfc\u6211\u4eec\uff0c\u5e0c\u671b\u7684\u662f\u4f60\u9886\u5bfc\u7740\u6211\u4eec\uff01","_text_en":"I
    followed you because I believed in you.And I still believe \u2014 until the day
    we both fall.I want it to be you who leads us\uff01","_text_jp":"\u4ffa\u306f\u304a\u524d\u3092\u4fe1\u3058\u3066\u3064\u3044\u3066\u304d\u305f\u3002\u5012\u308c\u308b\u307e\u3067\u4fe1\u3058\u7d9a\u3051\u308b\u3002\u304a\u524d\u306b\u7387\u3044\u3066\u307b\u3057\u3044\u3001\u305d\u3046\u671b\u3093\u3067\u3044\u308b\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":273.1516,"y":3354.726},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"40"},{"FaceType":{"_value":15},"statement":{"_text":"\u4f60\u5f97\u633a\u4f4f\u4e86\uff01","_text_en":"You
    must hang in there!","_text_jp":"\u3057\u3063\u304b\u308a\u3057\u308d\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":388.8374,"y":3444.347},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"41"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u77e5\u9053\u3002\u3002\u3002","_text_en":"You
    know\u2026","_text_jp":"\u77e5\u3063\u3066\u3044\u308b\u304b\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":394.0043,"y":3535.01},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"42"},{"FaceType":{"_value":11},"statement":{"_text":"\u90a3\u5929\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"That
    day\u2026","_text_jp":"\u3042\u306e\u65e5\u306f\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":400.2138,"y":3619.417},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"43"},{"FaceType":{"_value":11},"statement":{"_text":"\u90a3\u5929\u662f\u6211\u4e0b\u7684\u4ee4\u3002","_text_en":"That
    day, it was my order.","_text_jp":"\u4ffa\u304c\u547d\u4ee4\u3092\u51fa\u3057\u305f\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":388.6985,"y":3727.804},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"44"},{"FaceType":{"_value":16},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":585.0,"y":3784.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"45"},{"FaceType":{"_value":16},"statement":{"_text":"\u4ec0\u4e48?\uff01","_text_en":"What?!","_text_jp":"\u4f55\u3060\u3063\u3066\uff1f\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":411.729,"y":3841.543},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"46"},{"FaceType":{"_value":17},"statement":{"_text":"\u4e3a\u4ec0\u4e48\uff01","_text_en":"Why?!","_text_jp":"\u306a\u305c\u3060\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":393.958,"y":3930.121},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"47"},{"FaceType":{"_value":11},"statement":{"_text":"\u90a3\u662f\u6211\u4eec\u6253\u4e86\u4e00\u8f88\u5b50\u5343\u8f7d\u96be\u9022\u7684\u673a\u4f1a\uff0c\u5982\u679c\u51b2\u8fdb\u53bb\u4e86\u80fd\u6539\u53d8\u672a\u6765\u767e\u5e74\u7684\u5c40\u52bf\u3002","_text_en":"It
    was the one chance in a lifetime we had after a life of fighting.If we had broken
    through, we could\u2019ve changed the course of history for the next hundred
    years.","_text_jp":"\u4ffa\u305f\u3061\u306f\u4e00\u751f\u306b\u4e00\u5ea6\u306e\u5343\u8f09\u4e00\u9047\u306e\u30c1\u30e3\u30f3\u30b9\u3092\u63b4\u3093\u3060\u3002\u7a81\u5165\u3059\u308c\u3070\u767e\u5e74\u306e\u6d41\u308c\u3092\u5909\u3048\u3089\u308c\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":249.9822,"y":4023.865},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"48"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u77e5\u9053\u5e0c\u671b\u6e3a\u832b\uff0c\u4f46\u6211\u8fd8\u662f\u60f3\u8d4c\u4e00\u628a\u3002","_text_en":"I
    know the chances are slim, but I\u2019m still willing to bet everything on it.","_text_jp":"\u5e0c\u671b\u306f\u8584\u3044\u3068\u77e5\u308a\u3064\u3064\u3082\u3001\u8ced\u3051\u305f\u304b\u3063\u305f\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":342.7301,"y":4112.443},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"49"},{"FaceType":{"_value":17},"statement":{"_text":"\u5e26\u53bb\u4e86\u56db\u4e2a\u9a91\u58eb\u56e2\uff0c\u51e0\u5343\u4eba\uff0c\u56de\u6765\u4e0d\u5230\u4e8c\u767e\u4eba\uff0c\u519b\u56e2\u957f\u5168\u90e8\u9635\u4ea1\uff0c\u8fd9\u5c31\u662f\u673a\u4f1a\uff1f\uff01\u8fd9\u5c31\u662f\u4f60\u8ba4\u4e3a\u7684\u673a\u4f1a\uff01","_text_en":"You
    took four cavalry corps \u2014 thousands of troops \u2014 and came back with
    less than two hundred.All the commanders died.That\u2019s your \u201cchance\u201d?!","_text_jp":"\u56db\u9a0e\u58eb\u56e3\u3068\u6570\u5343\u306e\u5175\u3092\u9023\u308c\u3066\u3044\u304d\u3001\u4e8c\u767e\u3082\u623b\u3089\u306a\u304b\u3063\u305f\u3002\u8ecd\u56e3\u9577\u3082\u5168\u6ec5\u3002\u3053\u308c\u304c\u30c1\u30e3\u30f3\u30b9\u304b\uff1f\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":267.7532,"y":4208.458},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"50"},{"FaceType":{"_value":17},"statement":{"_text":"\u6211\u4eec\u662f\u53bb\u89e3\u56f4\uff01","_text_en":"We
    were supposed to be relieving the siege!","_text_jp":"\u4ffa\u305f\u3061\u306f\u6551\u63f4\u306b\u5411\u304b\u3063\u305f\u3093\u3060\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":369.8848,"y":4315.803},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"51"},{"FaceType":{"_value":11},"statement":{"_text":"\u8fd9\u662f\u6211\u4e00\u751f\u6700\u5927\u7684\u6127\u759a\u3002","_text_en":"It\u2019s
    the deepest regret of my life.","_text_jp":"\u3053\u308c\u304c\u4e00\u751f\u306e\u5f8c\u6094\u3060\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":327.0443,"y":4423.101},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"52"},{"FaceType":{"_value":11},"statement":{"_text":"\u5f53\u6211\u5f97\u77e5\u8bfa\u8d5b\u5c14\u9047\u88ad\uff0c\u773c\u524d\u4e00\u7247\u7729\u6655\uff0c\u6211\u600e\u4e48\u4e5f\u6ca1\u80fd\u60f3\u5230\u4f1a\u6709\u8fd9\u79cd\u4e8b\u3002","_text_en":"When
    I heard Norsel was under attack, I blacked out.Never imagined things would go
    that way.","_text_jp":"\u30ce\u30fc\u30bb\u30fc\u30eb\u8972\u6483\u3092\u77e5\u3063\u305f\u3068\u304d\u3001\u76ee\u7729\u304c\u3057\u305f\u3002\u305d\u3093\u306a\u3053\u3068\u304c\u8d77\u3053\u308b\u3068\u306f\u601d\u308f\u306a\u304b\u3063\u305f\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":304.0601,"y":4532.531},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"53"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u4e0b\u4ee4\u64a4\u56de\u519b\u56e2\uff0c\u9b54\u65cf\u7684\u5deb\u5e08\u90e8\u961f\u8d76\u5230\u4e86\uff0c\u5b83\u4eec\u7684\u9b54\u6cd5\u9635\u5c01\u4f4f\u4e86\u6211\u4eec\u7684\u9000\u8def\u3002","_text_en":"I
    ordered the army to retreat, but the demon clan\u2019s mage troops had already
    arrived.Their spell formation blocked our way out.","_text_jp":"\u8ecd\u56e3\u64a4\u9000\u3092\u547d\u3058\u305f\u304c\u3001\u9b54\u65cf\u306e\u9b54\u6cd5\u90e8\u968a\u304c\u6765\u3066\u9000\u8def\u3092\u5c01\u3058\u305f\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":316.5254,"y":4629.449},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"54"},{"FaceType":{"_value":11},"statement":{"_text":"\u56db\u4f4d\u56e2\u957f\u5e26\u4eba\u62fc\u6b7b\u51b2\u8fdb\u9698\u53e3\u6740\u4e86\u90a3\u51e0\u4e2a\u5deb\u5e08\u89e3\u9664\u4e86\u672f\u9635\u6211\u4eec\u624d\u64a4\u4e86\u56de\u6765\u3002","_text_en":"The
    four captains led a charge through the pass and killed the mages, dispelling
    the barrier so we could escape.","_text_jp":"\u56db\u4eba\u306e\u56e3\u9577\u304c\u4eba\u3092\u7387\u3044\u3066\u5fc5\u6b7b\u306b\u5deb\u5e2b\u3092\u5012\u3057\u8853\u9663\u3092\u89e3\u9664\u3057\u3001\u3088\u3046\u3084\u304f\u64a4\u9000\u3067\u304d\u305f\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":303.9675,"y":4744.092},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"55"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u5bf9\u4e0d\u8d77\u4ed6\u4eec\uff0c\u751a\u81f3\u6ca1\u80fd\u529b\u66ff\u4ed6\u4eec\u6536\u5c38\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"I''m
    sorry for them, I don''t even have the ability to collect their bodies for them","_text_jp":"\u5f7c\u3089\u306b\u7533\u3057\u8a33\u306a\u3044\u3001\u907a\u4f53\u3092\u62fe\u3046\u3053\u3068\u3082\u3067\u304d\u306a\u304b\u3063\u305f\u2026"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":353.9675,"y":4827.456},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"56"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u7792\u4e86\u516b\u5e74\u3002","_text_en":"You\u2019ve
    kept this from us for eight years.","_text_jp":"\u516b\u5e74\u9593\u96a0\u3057\u3066\u3044\u305f\u306a\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":461.8859,"y":4925.393},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"57"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u5f88\u60ed\u6127\u3002","_text_en":"I\u2019m
    deeply ashamed.","_text_jp":"\u6065\u305a\u304b\u3057\u3044\u3002"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":450.8859,"y":5018.211},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"58"},{"FaceType":{"_value":11},"statement":{"_text":"\u73b0\u5728\uff0c\u4f60\u8fd8\u613f\u610f\u76f8\u4fe1\u6211\u5417\u3002","_text_en":"now 
    do you still believe in me?","_text_jp":"\u4eca\u3067\u3082\u4ffa\u3092\u4fe1\u3058\u3066\u304f\u308c\u308b\u304b\uff1f"},"_actorName":"\u738b","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":456.6264,"y":5111.978},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"59"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u8981\u53bb\u4e1c\u5cb8\u4e86\u3002","_text_en":"I\u2019m
    heading to the East Coast.","_text_jp":"\u3053\u308c\u304b\u3089\u6771\u6d77\u5cb8\u306b\u5411\u304b\u3044\u307e\u3059\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":458.6654,"y":5207.854},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"60"},{"FaceType":{"_value":11},"statement":{"_text":"\u51ef\uff0c\u4f60\u662f\u6211\u4eec\u9f99\u65cf\u7684\u7cbe\u795e\u4fe1\u4ef0\u3002","_text_en":"Kai\u2026
