  _boundGraphSerialization: '{"type":"NodeCanvas.DialogueTrees.DialogueTree","nodes":[{"_action":{"actions":[{"StartAlpha":{},"EndAlpha":{"_value":1.0},"Duration":{"_value":0.7},"Delay":{},"EndActonOnAnimationEnd":{},"$type":"Game.GameRuntime.Story.Node.NormalDialogueUIAlphaAnimationTaskAction"},{"canvasGroup":{"_name":"YaerCanvasGroup","_targetVariableID":"dcffb376-f8c4-4f17-9b8b-8ddc9a11e07e"},"StartAlpha":{},"EndAlpha":{"_value":1.0},"Duration":{"_value":0.7},"EndActionOnAnimationEnd":{},"$type":"CanvasGroupAlphaActionTask"},{"canvasGroup":{"_name":"XiaerCanvasGroup","_targetVariableID":"a9de119d-cf83-4432-b904-784d7efc65fd"},"StartAlpha":{},"EndAlpha":{"_value":1.0},"Duration":{"_value":0.7},"EndActionOnAnimationEnd":{},"$type":"CanvasGroupAlphaActionTask"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":440.0,"y":49.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"0"},{"FaceType":{"_value":10},"statement":{"_text":"\u96c5\u5c14\u6765\u548c\u6211\u4e00\u8d77\u73a9\u5427!","_text_en":"Yar,
    come play with me!","_text_jp":"\u30e4\u30fc\u30eb\u3001\u4e00\u7dd2\u306b\u904a\u307c\u3046\u3088\uff01"},"_actorName":"\u590f\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":473.0,"y":212.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"1"},{"FaceType":{"_value":5},"statement":{"_text":"\u590f\u5c14?
    \u4eca\u5929\u53ef\u80fd\u4e0d\u884c\u4e86\u590f\u5c14\u3002","_text_en":"Shire\uff1fI
    don''t think I can today.","_text_jp":"\u30b7\u30e3\u30fc\u30eb\uff1f\u3054\u3081\u3093\u3001\u4eca\u65e5\u306f\u7121\u7406\u305d\u3046\u306a\u306e\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"f4ac873c-c968-4792-8b08-05e690ebcbe2","_position":{"x":441.0,"y":303.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"2"},{"FaceType":{"_value":7},"statement":{"_text":"\u4e3a\u4ec0\u4e48\uff0c\u5e73\u65f6\u90fd\u53ef\u4ee5\u7684\u3002","_text_en":"Why
    not? You always can.","_text_jp":"\u306a\u3093\u3067\uff1f\u5e73\u65f6\u90fd\u53ef\u4ee5\u7684\u3002"},"_actorName":"\u590f\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":483.0,"y":412.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"3"},{"FaceType":{"_value":9},"statement":{"_text":"\u56e0\u4e3a\u6211\u9a6c\u4e0a\u8981\u51fa\u8fdc\u95e8\u4e86\uff0c\u53ef\u80fd\u8981\u5f88\u4e45\u624d\u80fd\u56de\u6765\u3002","_text_en":"Because
    I''m about to go on a long journey. I might not be back for a while.","_text_jp":"\u3059\u3050\u306b\u9060\u304f\u3078\u65c5\u7acb\u3064\u306e\u3002\u5e30\u3063\u3066\u304f\u308b\u306e\u306b\u3001\u3059\u3054\u304f\u6642\u9593\u304c\u304b\u304b\u308b\u304b\u3082\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"f4ac873c-c968-4792-8b08-05e690ebcbe2","_position":{"x":409.0,"y":499.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"4"},{"FaceType":{"_value":7},"statement":{"_text":"\u5f88\u4e45\u662f\u591a\u957f\u65f6\u95f4\u3002\u3002\u3002\u3002\u3002\u96c5\u5c14\u4e0d\u5728\u6ca1\u4eba\u966a\u590f\u5c14\u73a9\u4e86\u3002","_text_en":"How
    long is \"a while\"...? No one''s going to play with me if you''re gone.","_text_jp":"\u9577\u3044\u3063\u3066\u3001\u3069\u308c\u304f\u3089\u3044\uff1f\u2026\u2026\u3002\r\u30e4\u30fc\u30eb\u304c\u3044\u306a\u3044\u3068\u3001\u30b7\u30e3\u30fc\u30eb\u3068\u904a\u3093\u3067\u304f\u308c\u308b\u4eba\u304c\u3044\u306a\u304f\u306a\u308b\u3088\u3002"},"_actorName":"\u590f\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":371.0,"y":588.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":1},"statement":{"_text":"\u8fd9\u4e2a\u3002\u3002\u3002\u3002\u5177\u4f53\u6211\u4e5f\u4e0d\u77e5\u9053\uff0c\u6211\u8981\u53bb\u5f88\u8fdc\u7684\u5730\u65b9\u627e\u4e1c\u897f\uff0c\u6211\u4e0d\u5728\u7684\u65e5\u5b50\u590f\u5c14\u8981\u81ea\u5df1\u7167\u987e\u81ea\u5df1\uff0c\u8ddf\u5973\u4ec6\u4eec\u73a9\u5427\u3002","_text_en":"Well...
    I\u2019m not exactly sure. I have to travel far to find something. While I\u2019m
    away, you\u2019ll have to take care of yourself and play with the maids, okay?","_text_jp":"\u3048\u3063\u3068\u2026\u2026\u5177\u4f53\u7684\u306b\u306f\u308f\u304b\u3089\u306a\u3044\u3051\u3069\u3001\u3059\u3054\u304f\u9060\u304f\u3078\u884c\u3063\u3066\u3001\u3082\u306e\u3092\u63a2\u3055\u306a\u3044\u3068\u3002\u79c1\u304c\u3044\u306a\u3044\u9593\u3001\u30b7\u30e3\u30eb\u306f\u81ea\u5206\u3067\u81ea\u5206\u306e\u3053\u3068\u3092\u3061\u3083\u3093\u3068\u3057\u306a\u3044\u3068\u306d\uff0c\u30e1\u30a4\u30c9\u3055\u3093\u305f\u3061\u3068\u904a\u3093\u3067\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"f4ac873c-c968-4792-8b08-05e690ebcbe2","_position":{"x":385.0,"y":691.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"6"},{"FaceType":{"_value":7},"statement":{"_text":"\u54e6\u3002\u3002\u3002\u3002\u3002\u3002\u4e0d\u80fd\u5e26\u6211\u53bb\u5417
    ?","_text_en":"Oh... Can\u2019t I come with you?","_text_jp":"\u305d\u3063\u304b\u2026\u2026\u4e00\u7dd2\u306b\u306f\u884c\u3051\u306a\u3044\u306e\uff1f"},"_actorName":"\u590f\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":469.0,"y":788.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"7"},{"FaceType":{"_value":4},"statement":{"_text":"\u590f\u5c14\u8fd8\u592a\u5c0f\u4e86\uff0c\u6211\u8981\u53bb\u5f88\u8fdc\u7684\u5730\u65b9\uff0c\u53ef\u80fd\u4f1a\u5f88\u5371\u9669\u3002\u590f\u5c14\u8981\u4e56\u4e56\u7684\u3002","_text_en":"You\u2019re
    still too little, Shire. I\u2019m going somewhere far and it might be dangerous.
    Be good, alright?","_text_jp":"\u30b7\u30e3\u30fc\u30eb\u306f\u307e\u3060\u5c0f\u3055\u3044\u304b\u3089\u306d\u3002\u305d\u3053\u306f\u5371\u306a\u3044\u3068\u3053\u308d\u304b\u3082\u3057\u308c\u306a\u3044\u304b\u3089,\u30b7\u30e3\u30eb\u306f\u3044\u3044\u5b50\u306b\u3057\u3066\u3066\u306d\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"f4ac873c-c968-4792-8b08-05e690ebcbe2","_position":{"x":366.0,"y":895.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":7},"statement":{"_text":"\u54e6\u3002\u3002\u3002","_text_en":"Okay\u2026","_text_jp":"\u3046\u3093\u2026\u2026\u3002"},"_actorName":"\u590f\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":509.0,"y":1006.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"4"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"4"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"5"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"6"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"7"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"9"},"$type":"NodeCanvas.DialogueTrees.DTConnection"}],"canvasGroups":[],"localBlackboard":{"_variables":{}},"derivedData":{"actorParameters":[{"_keyName":"\u590f\u5c14","_id":"3abe8617-3237-414c-bdb8-549c0134f2d0","_actorObject":1},{"_keyName":"\u96c5\u5c14",