    leave the house?","_text_jp":"\u3069\u3046\u3044\u3046\u3053\u3068\u3067\u5916\u306b\u51fa\u3066\u304d\u305f\u306e\uff1f"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":340.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":32},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u6709\u70b9\u96be\u4e3a\u60c5\u3002\u3002\u3002\u3002\u3002\u3002\u5176\u5b9e\u5c31\u662f\u6253\u788e\u4e86\u4e00\u4e2a\u88c5\u9970\u54c1\u3002","_text_en":"It\u2019s
    a little embarrassing\u2026 actually, I broke a piece of ornament.","_text_jp":"\u3061\u3087\u3063\u3068\u6065\u305a\u304b\u3057\u3044\u3093\u3060\u3051\u3069\u2026\u2026\u3001\u5b9f\u306f\u88c5\u98fe\u54c1\u3092\u58ca\u3057\u3066\u3057\u307e\u3063\u3066\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":460.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"6"},{"FaceType":{"_value":32},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u6211\u7236\u4eb2\u633a\u73cd\u60dc\u90a3\u4e2a\u77f3\u5934\uff0c\u53eb\u6211\u51fa\u95e8\u627e\u4fee\u590d\u6750\u6599\u3002","_text_en":"My
    father cherishes that stone very much, so he asked me to go out and find material
    to repair it.","_text_jp":"\u7236\u304c\u3042\u306e\u77f3\u3092\u3068\u3066\u3082\u5927\u4e8b\u306b\u3057\u3066\u3044\u3066\u3001\u76f4\u3059\u305f\u3081\u306e\u6750\u6599\u3092\u63a2\u3057\u306b\u51fa\u3066\u304d\u305f\u306e\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":580.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"7"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u662f\u4e0d\u662f\u4e00\u5757\u84dd\u8272\u7684\uff1f","_text_en":"Is
    it a blue stone?","_text_jp":"\u3042\u306e\u9752\u3044\u77f3\u306e\u3053\u3068\u304b\u3044\uff1f"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":700.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":4},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u662f\u554a\u3002","_text_en":"Yes.","_text_jp":"\u305d\u3046\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":820.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{"_value":2},"statement":{"_text":"\u5475\u5475\uff0c\u90a3\u53ef\u4e0d\u662f\u4e2a\u666e\u901a\u7684\u88c5\u9970\u54c1\u3002","_text_en":"Heh
    \u2014 that\u2019s not just an ordinary ornament.","_text_jp":"\u3075\u3075\u3001\u305d\u308c\u306f\u666e\u901a\u306e\u88c5\u98fe\u54c1\u3058\u3083\u306a\u3044\u3088\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":940.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{"_value":2},"statement":{"_text":"\u90a3\u662f\u4f60\u7236\u4eb2\u5f53\u5e74\u548c\u4f60\u6bcd\u4eb2\u5b9a\u60c5\u540e\uff0c\u7cbe\u7075\u65cf\u7528\u9b54\u6cd5\u68ee\u6797\u91cc\u7684\u9b54\u77f3\u6253\u9020\u7684\u4fe1\u7269\u9001\u7ed9\u90a3\u5bf9\u65b0\u4eba\u7684\u3002","_text_en":"That
    was given by the Elves from the magic forest \u2014 a love token forged from
    magic stone, \rgiven to your parents when they pledged their hearts.","_text_jp":"\u305d\u308c\u306f\u3001\u304a\u7236\u69d8\u3068\u304a\u6bcd\u69d8\u304c\u7d50\u5a5a\u3055\u308c\u305f\u5f8c\u306b\u3001\u7cbe\u970a\u65cf\u304c\u9b54\u6cd5\u306e\u68ee\u306e\u9b54\u77f3\u3092\u4f7f\u3063\u3066\u4f5c\u3063\u305f\u8d08\u308a\u7269\u3068\u3057\u3066\u3001\r\u65b0\u5a5a\u306e\u4e8c\u4eba\u306b\u9001\u3063\u305f\u3082\u306e\u306a\u306e\u3067\u3059\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":1060.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{"_value":2},"statement":{"_text":"\u4f60\u7236\u4eb2\u73cd\u89c6\u5b83\u662f\u5fc5\u7136\u7684\u3002","_text_en":"It
    is inevitable that your father cherishes it.","_text_jp":"\u3060\u304b\u3089\u3001\u304a\u7236\u3055\u3093\u304c\u5927\u5207\u306b\u3059\u308b\u306e\u3082\u5f53\u7136\u3060\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":1180.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"FaceType":{"_value":7},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u554a\u3002\u3002\u3002\u3002\u3002\u4ed6\u4ece\u672a\u8ddf\u6211\u63d0\u8d77\u8fc7\u3002\u3002\u3002\u3002\u3002","_text_en":"Ah\u2026
    he never told me any of that\u2026","_text_jp":"\u3042\u3042\u2026\u2026\u4eca\u307e\u3067\u4e00\u5ea6\u3082\u79c1\u306b\u305d\u306e\u3053\u3068\u3092\u8a71\u3057\u305f\u3053\u3068\u304c\u306a\u304b\u3063\u305f\u2026\u2026\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":201.0,"y":1300.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"13"},{"FaceType":{"_value":7},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u8981\u662f\u77e5\u9053\u6211\u5c31\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"If
    I had known, I would\u2019ve\u2026","_text_jp":"\u3082\u3057\u77e5\u3063\u3066\u3044\u305f\u306a\u3089\u3001\u79c1\u2026\u2026\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":1420.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"14"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{"_value":2},"statement":{"_text":"\u522b\u61ca\u6094\u4e86\uff0c\u6211\u731c\u4f60\u5e94\u8be5\u662f\u627e\u8d77\u6e90\u4e4b\u77f3\u5427\u3002","_text_en":"Don\u2019t
    regret it. I guess the stone you''re looking for is the Origin Stone, right?","_text_jp":"\u6094\u3084\u307e\u306a\u3044\u3067\u3002\u541b\u304c\u63a2\u3057\u3066\u3044\u308b\u306e\u306f\u300c\u8d77\u6e90\u306e\u77f3\u300d\u3060\u308d\u3046\uff1f"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":1540.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"15"},{"FaceType":{"_value":5},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u5bf9!\u5c31\u662f\u8fd9\u4e2a\u3002","_text_en":"Yes!
    That\u2019s exactly it.","_text_jp":"\u306f\u3044\uff01\u305d\u308c\u3067\u3059\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":1659.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"16"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{"_value":1},"statement":{"_text":"\u8fd9\u4e2a\u4e1c\u897f\u6240\u5728\u4e4b\u5730\u60f3\u5fc5\u4f60\u7236\u4eb2\u5e94\u8be5\u662f\u8ddf\u4f60\u8bb2\u4e86\uff0c\u80af\u5b9a\u6ca1\u90a3\u4e48\u5bb9\u6613\u5f97\u5230\u4e86\u3002","_text_en":"Your
    father must have spoken about its location, but it\u2019s not something you can
    get easily.","_text_jp":"\u3042\u306e\u77f3\u304c\u3042\u308b\u5834\u6240\u306f\u3001\u304a\u7236\u3055\u3093\u3082\u541b\u306b\u8a71\u3057\u305f\u306b\u9055\u3044\u306a\u3044\u3002\u7c21\u5358\u306b\u306f\u624b\u306b\u5165\u3089\u306a\u3044\u3082\u306e\u3060\u3088\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":1780.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"17"},{"FaceType":{"_value":5},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u4ed6\u8bf4\u662f\u9b54\u65cf\u7684\u4e1c\u897f\uff0c\u4f46\u88ab\u76d7\u7a83\u4e86\uff0c\u4e0d\u77e5\u9053\u5728\u8c01\u90a3\u3002","_text_en":"He
    said it belongs to the demon race, but it was stolen \u2014 I don\u2019t know
    who has it now.","_text_jp":"\u7236\u306f\u9b54\u65cf\u306e\u3082\u306e\u3060\u3068\u8a00\u3063\u3066\u3044\u305f\u3051\u3069\u3001\u76d7\u307e\u308c\u3066\u8ab0\u304b\u306e\u624b\u306b\u3042\u308b\u3089\u3057\u3044\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":1900.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"18"},{"FaceType":{"_value":5},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u8ba9\u6211\u5148\u524d\u5f80\u4eba\u7c7b\u7684\u57ce\u5e02\u6253\u542c\u4e0b\u843d\u3002","_text_en":"So
    first I want to go to the human city to ask around.","_text_jp":"\u3060\u304b\u3089\u307e\u305a\u306f\u4eba\u985e\u306e\u90fd\u5e02\u306b\u884c\u3063\u3066\u3001\u884c\u65b9\u3092\u63a2\u305d\u3046\u3068\u601d\u3063\u3066\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":2020.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"19"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u8981\u53bb\u4eba\u7c7b\u57ce\u5e02\u7684\u8bdd\uff0c\u5f97\u7ecf\u8fc7\u6211\u4eec\u6751\u5b50\u5357\u8fb9\u7684\u5c0f\u8def\uff0c\u4f46\u90a3\u6761\u8def\u65e9\u5e74\u4e3a\u4e86\u9632\u5fa1\u654c\u4eba\u88ab\u5835\u6b7b\u4e86\u3002","_text_en":"To
    go to the human city, you\u2019d normally take the southern road, but long ago
    it was blocked \rfor defense.","_text_jp":"\u4eba\u985e\u306e\u90fd\u5e02\u3078\u884c\u304f\u306a\u3089\u3001\u5357\u306e\u9053\u3092\u901a\u308b\u306f\u305a\u3060\u304c\u3001\u6614\u3001\u9632\u885b\u306e\u305f\u3081\u306b\u585e\u304c\u308c\u3066\u3057\u307e\u3063\u305f\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":2140.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"20"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u73b0\u5728\u53ea\u80fd\u901a\u8fc7\u5317\u9762\u7684\u5c0f\u8def\u7ed5\u884c\u3002","_text_en":"Now
    you can only go around via the northern path.","_text_jp":"\u4eca\u306f\u5317\u306e\u5c0f\u9053\u3092\u56de\u3063\u3066\u884c\u304f\u3057\u304b\u306a\u3044\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":2260.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"21"},{"FaceType":{"_value":4},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u539f\u6765\u662f\u8fd9\u6837\uff0c\u90a3\u6211\u8fd9\u5c31\u51fa\u53d1\u4e86\u3002","_text_en":"I
    see\u2026 then I will depart now.","_text_jp":"\u305d\u3046\u306a\u3093\u3060\u2026\u2026\u3058\u3083\u3042\u3001\u4eca\u51fa\u767a\u3059\u308b\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":2380.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"22"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u522b\u6025\u6211\u8fd8\u6ca1\u8bf4\u5b8c\u3002","_text_en":"Wait,
    I haven\u2019t finished.","_text_jp":"\u3061\u3087\u3063\u3068\u5f85\u3063\u3066\u3001\u8a71\u304c\u7d42\u308f\u3063\u3066\u306a\u3044\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":2500.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"23"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u5317\u8fb9\u7684\u8def\u4e4b\u524d\u7684\u66b4\u96e8\u5bfc\u81f4\u4e00\u4e9b\u6811\uff0c\u5c71\u77f3\u6ed1\u843d\uff0c\u4e5f\u963b\u585e\u4e86\uff0c\u6e05\u7406\u9700\u8981\u4e9b\u65e5\u5b50\u3002","_text_en":"The
    north road was clogged because of a heavy rain back then \u2014 trees and rocks
    fell. \rIt will take days to clear.","_text_jp":"\u5317\u306e\u9053\u306f\u4ee5\u524d\u306e\u5927\u96e8\u3067\u3001\u6728\u3084\u5ca9\u304c\u5d29\u308c\u3066\u585e\u304c\u3063\u3066\u3044\u308b\u3068\u3053\u308d\u304c\u3042\u308b\u3002\u7247\u3065\u3051\u308b\u306b\u306f\r\u6642\u9593\u304c\u304b\u304b\u308b\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":2620.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"24"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u4ece\u5317\u9762\u51fa\u53d1\uff0c\u4f60\u8981\u9014\u5f84\u4e00\u6bb5\u6df1\u6797\uff0c\u62b5\u8fbe\u6211\u4eec\u66fe\u7ecf\u7684\u9886\u5730\u83ab\u5c14\u6cd5\u65af\u3002","_text_en":"If
    you go north, you must pass through a deep forest, reaching our former territory,
    Morphas.","_text_jp":"\u5317\u304b\u3089\u51fa\u767a\u3059\u308b\u3068\u3001\u6df1\u3044\u68ee\u3092\u901a\u3063\u3066\u3001\u304b\u3064\u3066\u306e\u9818\u5730\u30e2\u30eb\u30d5\u30a1\u30b9\u3092\u901a\u308b\u3053\u3068\u306b\u306a\u308b\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":2740.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"25"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u90a3\u91cc\u5df2\u7ecf\u8352\u5e9f\u4e86\u591a\u5e74\uff0c\u60f3\u5fc5\u602a\u7269\u4e00\u5b9a\u5360\u636e\u4e86\u3002","_text_en":"It\u2019s
    been abandoned for years \u2014 monsters surely dwell there.","_text_jp":"\u305d\u3053\u306f\u4f55\u5e74\u3082\u8352\u308c\u679c\u3066\u3066\u3044\u3066\u3001\u304d\u3063\u3068\u602a\u7269\u304c\u5360\u62e0\u3057\u3066\u3044\u308b\u3060\u308d\u3046\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":2860.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"26"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u83ab\u5c14\u6cd5\u65af\u518d\u5f80\u5357\u8d70\u5c31\u662f\u671d\u4eba\u7c7b\u9886\u5730\u524d\u8fdb\u4e86\u3002","_text_en":"And
    if you go further south from Morphas, you will enter human lands.","_text_jp":"\u30e2\u30eb\u30d5\u30a1\u30b9\u3092\u904e\u304e\u3066\u5357\u3078\u884c\u304f\u3068\u3001\u4eba\u9593\u306e\u9818\u5730\u306b\u305f\u3069\u308a\u7740\u3051\u308b\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":201.0,"y":2980.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"27"},{"FaceType":{"_value":5},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u6ca1\u6709\u5176\u4ed6\u7684\u8def\u4e86\u5417\uff1f\u6211\u60f3\u8d76\u7d27\u56de\u53bb\u7167\u987e\u590f\u5c14\uff0c\u5979\u89c1\u4e0d\u5230\u6211\u4f1a\u5f88\u96be\u8fc7\u3002","_text_en":"Is
    there no other route? I want to return quickly to care for Shire \u2014 she\u2019ll
    be sad if she can\u2019t see me.","_text_jp":"\u307b\u304b\u306b\u9053\u306f\u306a\u3044\u306e\uff1f\u3059\u3050\u306b\u5e30\u3063\u3066\u30b7\u30e3\u30fc\u30eb\u306e\u3068\u3053\u308d\u3078\u623b\u308a\u305f\u3044\u3002\u5f7c\u5973\u304c\u79c1\u3092\u898b\u3089\u308c\r\u306a\u3044\u3068\u5bc2\u3057\u304c\u308b\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":3100.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"28"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{"_value":1},"statement":{"_text":"\u6ca1\u6709\u4e86\uff0c\u90a3\u573a\u6218\u4e89\u540e\u6211\u4eec\u51e0\u4e4e\u963b\u65ad\u548c\u5916\u754c\u7684\u8054\u7cfb\u3002","_text_en":"There
    is no other way. After the war, we almost cut off contact with the outside world.","_text_jp":"\u6b8b\u5ff5\u306a\u304c\u3089\u3001\u4ed6\u306b\u306f\u306a\u3044\u3002\u3042\u306e\u6226\u4e89\u306e\u5f8c\u3001\u79c1\u305f\u3061\u306f\u5916\u754c\u3068\u306e\u9023\u7d61\u3092\u307b\u307c\u65ad\u3063\u3066\u3057\u307e\u3063\u305f\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":3220.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"29"},{"FaceType":{"_value":5},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u90a3\u8981\u7b49\u591a\u4e45\u5462\uff1f","_text_en":"How
    long will we have to wait, then?","_text_jp":"\u3058\u3083\u3042\u3001\u3069\u308c\u304f\u3089\u3044\u5f85\u3066\u3070\u3044\u3044\u306e\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":3340.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"30"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{"_value":1},"statement":{"_text":"\u6211\u4eec\u7537\u4e01\u4e0d\u591a\uff0c\u5927\u591a\u662f\u8001\u5f31\u5987\u5b7a\uff0c\u524d\u4e24\u5929\u53c8\u6709\u4eba\u53d7\u4f24\u4e86\uff0c\u53ef\u80fd\u8fd8\u5f97\u534a\u4e2a\u6708\u3002","_text_en":"Our
    manpower is scarce. Most of our men are old or injured, and some were hurt recently
    \u2014 it \rmight take another half month.","_text_jp":"\u6211\u3046\u3061\u306e\u7537\u624b\u304c\u5c11\u306a\u3044\u3093\u3060\u3002\u591a\u304f\u306f\u304a\u5e74\u5bc4\u308a\u3068\u5973\u6027\u3067\u3001\u5148\u65e5\u3082\u8ab0\u304b\u304c\u3051\u304c\u3092\u3057\u3066\u3001\r\u307e\u3060\u7247\u4ed8\u3051\u306b\u306f\u534a\u6708\u304f\u3089\u3044\u304b\u304b\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":201.0,"y":3460.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"31"},{"FaceType":{"_value":1},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u534a\u4e2a\u6708\u554a\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"Half
    a month\u2026","_text_jp":"\u534a\u6708\u304b\u2026\u2026\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"7a2ecdda-9869-40c2-a132-185b54cbe111","_position":{"x":200.0,"y":3580.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"32"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u5b69\u5b50\uff0c\u4f60\u521a\u521a\u7ecf\u5386\u8fc7\u6218\u6597\uff0c\u591a\u5c11\u4e5f\u77e5\u9053\u4e86\u8fd9\u5916\u9762\u7684\u5371\u9669\u3002","_text_en":"Child,
    you\u2019ve been through battle \u2014 you know how dangerous it is out there.","_text_jp":"\u5b50\u3069\u3082\u3088\u3001\u3042\u306a\u305f\u306f\u6226\u3044\u3082\u7d4c\u9a13\u3057\u305f\u3002\u5916\u306e\u5371\u967a\u304c\u3069\u308c\u307b\u3069\u304b\u3001\u5c11\u3057\u306f\u5206\u304b\u3063\u3066\u3044\u308b\u306f\u305a\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":3700.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"33"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u6025\u4e8e\u6c42\u6210\u53ef\u80fd\u4f1a\u6bc1\u4e86\u4e00\u5207\u3002","_text_en":"Rushing
    could destroy everything.","_text_jp":"\u6210\u529f\u3092\u6025\u3050\u3068\u3059\u3079\u3066\u304c\u53f0\u7121\u3057\u306b\u306a\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":200.0,"y":3820.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"34"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u770b\u4f60\u7684\u8863\u670d\u90fd\u7834\u4e86\u3002","_text_en":"I
    see your clothes are torn. ","_text_jp":"\u670d\u3082\u7834\u308c\u3066\u3044\u308b\u306d\u3002"},"_actorName":"\u6751\u957f","_actorParameterID":"07c4887c-86e1-4bb1-9a34-982c2ed86707","_position":{"x":201.0,"y":3939.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"35"},{"FaceType":{},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{"_value":true},"ChiefFace":{},"statement":{"_text":"\u6211\u8fd9\u91cc\u6709\u9488\u7ebf\u5305\uff0c\u4e00\u4f1a\u5e2e\u4f60\u628a\u8863\u670d\u8865\u4e00\u8865\u3002","_text_en":"I
