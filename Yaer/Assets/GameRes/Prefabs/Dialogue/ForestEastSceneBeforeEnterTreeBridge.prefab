    it''s really a huge tree.","_text_jp":"\u3046\u308f\u3041\u3001\u3059\u3054\u304f\u5927\u304d\u306a\u6728\u2026\u2026\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":704.6557,"y":54.7822},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"1"},{"FaceType":{"_value":5},"statement":{"_text":"\u592a\u9ad8\u4e86\u6211\u722c\u4e0d\u4e0a\u53bb\uff0c\u800c\u4e14\u6709\u5f88\u591a\u6728\u523a\u4f1a\u523a\u4f24\u6211\u3002","_text_en":"It''s
    too high for me to climb up, and there are many wooden spikes that will scratch
    me.","_text_jp":"\u9ad8\u3059\u304e\u3066\u767b\u308c\u306a\u3044\u3057\u3001\u30c8\u30b2\u304c\u3044\u3063\u3071\u3044\u3067\u30b1\u30ac\u3057\u3061\u3083\u3046\u304b\u3082\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":666.1018,"y":159.9989},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"2"},{"FaceType":{"_value":1},"statement":{"_text":"\u55ef\u3002\u3002\u3002\u3002\u3002","_text_en":"Hmm......","_text_jp":"\u3093\uff5e\uff5e\uff5e"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":734.04,"y":240.5861},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"3"},{"_action":{"StartPos":{"_name":"playerPos","_targetVariableID":"b8e603f5-8b1a-44a8-a5ca-714570158cd5"},"EndPos":{"_name":"CameraPos","_targetVariableID":"c14b353c-72a4-4ef1-9c67-b5a74298d29d"},"Duration":{"_value":2.0},"$type":"Game.GameRuntime.Story.Node.CameraMoveTaskAction"},"_position":{"x":1178.0,"y":168.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"4"},{"_action":{"waitTime":{"_value":1.5},"$type":"NodeCanvas.Tasks.Actions.Wait"},"_position":{"x":1228.0,"y":247.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"5"},{"_action":{"StartPos":{"_name":"CameraPos","_targetVariableID":"c14b353c-72a4-4ef1-9c67-b5a74298d29d"},"EndPos":{"_name":"playerPos","_targetVariableID":"b8e603f5-8b1a-44a8-a5ca-714570158cd5"},"Duration":{"_value":2.0},"$type":"Game.GameRuntime.Story.Node.CameraMoveTaskAction"},"_position":{"x":1228.0,"y":344.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"6"},{"_action":{"isFollowPlayer":{"_value":true},"$type":"Game.GameRuntime.Story.Node.CameraFollowPlayerActionTask"},"_position":{"x":1230.0,"y":437.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"7"},{"FaceType":{"_value":1},"statement":{"_text":"\u662f\u7a7a\u5fc3\u7684\uff0c\u4f3c\u4e4e\u4e2d\u95f4\u5feb\u8981\u65ad\u4e86\uff0c\u5e0c\u671b\u91cc\u9762\u8fd8\u597d\u3002","_text_en":"It''s
    hollow and seems to be about to break in the middle. I hope it''s okay inside.","_text_jp":"\u4e2d\u304c\u7a7a\u6d1e\u306b\u306a\u3063\u3066\u308b\u2026\u2026\u771f\u3093\u4e2d\u304c\u6298\u308c\u305d\u3046\u2026\u2026\u4e2d\u306f\u7121\u4e8b\u3060\u3068\u3044\u3044\u3051\u3069\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":691.4623,"y":357.8969},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":9},"statement":{"_text":"\u53c8\u8981\u94bb\u6811\u6d1e\u554a\uff0c\u9709\u5473\u597d\u5927\uff0c\u771f\u4e0d\u60f3\u8fdb\u53bb\u3002","_text_en":"We''re
    going to drill a tree hole again. The musty smell is so strong, I really don''t","_text_jp":"\u307e\u305f\u6728\u306e\u7a74\u306b\u5165\u3089\u306a\u304d\u3083\u3044\u3051\u306a\u3044\u306e\uff1f\u30ab\u30d3\u81ed\u3044\u3057\u3001\u672c\u5f53\u306b\u5165\u308a\u305f\u304f\u306a\u3044\u306a\u2026\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":701.4623,"y":451.8969},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{"_value":9},"statement":{"_text":"\u8fd8\u662f\u5fcd\u8010\u4e00\u4e0b\u5427","_text_en":"Try
    to tough it out a bit more.","_text_jp":"\u3067\u3082\u3001\u6211\u6162\u3057\u306a\u3044\u3068\u2026\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":741.4623,"y":555.8969},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"4"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"4"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"5"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"6"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"7"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"9"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"9"},"_targetNode":{"$ref":"10"},"$type":"NodeCanvas.DialogueTrees.DTConnection"}],"canvasGroups":[],"localBlackboard":{"_variables":{}},"derivedData":{"actorParameters":[{"_keyName":"\u96c5\u5c14","_id":"3abe8617-3237-414c-bdb8-549c0134f2d0","_actorObject":1},{"_keyName":"\u65c1\u767d","_id":"6aa85c51-8f46-4acd-98d2-94e524ef90ce","_actorObject":2}],"$type":"NodeCanvas.DialogueTrees.DialogueTree+DerivedSerializationData"}}'
