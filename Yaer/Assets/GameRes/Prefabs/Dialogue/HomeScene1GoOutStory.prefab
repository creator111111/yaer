    That sword\u2026","_text_jp":"\u3093\uff1f\u305d\u306e\u5263\u306f\u2026\u2026"},"_actorName":"\u738b","_actorParameterID":"980faa3c-7845-4377-bccf-e3425f25cfd2","_position":{"x":107.0268,"y":41.87802},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"2"},{"FaceType":{"_value":4},"statement":{"_text":"\u5728\u4e8c\u697c\u627e\u5230\u7684\uff0c\u6211\u770b\u6ca1\u6709\u4eba\u7528\u6211\u5c31\u5e26\u5728\u8eab\u4e0a\u5427\u3002","_text_en":"I
    found it on the second floor. Since no one was using it, I thought I''d keep
    it with me.","_text_jp":"2\u968e\u3067\u898b\u3064\u3051\u305f\u306e\u3002\u8ab0\u3082\u4f7f\u3063\u3066\u306a\u3055\u305d\u3046\u3060\u304b\u3089\u6301\u3063\u3066\u884c\u304f\u306d\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"66927cc3-253f-499b-8a8d-624fd10e9374","_position":{"x":5.991078,"y":136.878},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"3"},{"FaceType":{"_value":11},"statement":{"_text":"\u55ef\uff0c\u4e5f\u597d\uff0c\u5979\u5982\u679c\u5728\u4e5f\u4f1a\u540c\u610f\u7684\uff0c\u613f\u5b83\u4fdd\u4f51\u4f60\u3002","_text_en":"I
    see. That\u2019s fine. If she were here, she\u2019d agree too. May it protect
    you.","_text_jp":"\u3046\u3093\u3001\u305d\u308c\u3067\u3044\u3044\u3002\u3082\u3057\u5f7c\u5973\u304c\u3044\u305f\u3089\u8cdb\u6210\u3057\u305f\u3060\u308d\u3046\u3002\u5b88\u3063\u3066\u304f\u308c\u308b\u3088\u3046\u9858\u3063\u3066\u3044\u308b\u3088\u3002"},"_actorName":"\u738b","_actorParameterID":"980faa3c-7845-4377-bccf-e3425f25cfd2","_position":{"x":34.02682,"y":222.878},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"4"},{"FaceType":{"_value":9},"statement":{"_text":"\u8c01\u554a?","_text_en":"\"She\"?
    Who are you talking about?","_text_jp":"\u8ab0\u306e\u3053\u3068\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"66927cc3-253f-499b-8a8d-624fd10e9374","_position":{"x":166.0,"y":332.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":11},"statement":{"_text":"\u4e00\u4e2a\u4f60\u719f\u6089\u7684\u4eba\u3002","_text_en":"Someone
    you know well.","_text_jp":"\u541b\u306e\u77e5\u3063\u3066\u3044\u308b\u4eba\u3060\u3088\u3002"},"_actorName":"\u738b","_actorParameterID":"980faa3c-7845-4377-bccf-e3425f25cfd2","_position":{"x":127.0,"y":418.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"6"},{"FaceType":{"_value":5},"statement":{"_text":"\u548c\u590f\u5c14\u6253\u8fc7\u62db\u547c\u4e86\u5417\uff0c\u5979\u53ef\u60e6\u8bb0\u4f60\u4e86\u3002\n","_text_en":"Have
    you said goodbye to Shire? She\u2019s been thinking about you.","_text_jp":"\u30b7\u30e3\u30eb\u306b\u306f\u6328\u62f6\u3057\u305f\u304b\uff1f\u5f7c\u5973\u306f\u541b\u306e\u3053\u3068\u3092\u6c17\u306b\u304b\u3051\u3066\u3044\u308b\u3002"},"_actorName":"\u738b","_actorParameterID":"980faa3c-7845-4377-bccf-e3425f25cfd2","_position":{"x":92.0,"y":523.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"7"},{"FaceType":{"_value":4},"statement":{"_text":"\u6253\u8fc7\u4e86\uff0c\u5979\u8fd8\u628a\u5979\u6700\u559c\u6b22\u7684\u77f3\u5934\u7ed9\u4e86\u6211\u3002","_text_en":"
    I did. She even gave me her favorite stone.","_text_jp":"\u3057\u305f\u3088\u3002\u304a\u6c17\u306b\u5165\u308a\u306e\u77f3\u3082\u304f\u308c\u305f\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"66927cc3-253f-499b-8a8d-624fd10e9374","_position":{"x":103.0113,"y":642.0704},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{},"statement":{"_text":"\u590f\u5c14\u4ece\u91cc\u9762\u8dd1\u51fa\u6765\u62b1\u4f4f\u96c5\u5c14\u3002","_text_en":"Shire
    runs out and hugs Yaar tightly.","_text_jp":"\u30b7\u30e3\u30eb\u304c\u98db\u3073\u51fa\u3057\u3066\u96c5\u5c14\u306b\u62b1\u304d\u3064\u304f\u3002"},"_actorName":"\u65c1\u767d","_actorParameterID":"eee1bfb8-07cb-440e-bb22-0474cf118ce0","_position":{"x":137.015,"y":747.082},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{"_value":10},"statement":{"_text":"\u96c5\u5c14!","_text_en":"Yar\uff01","_text_jp":"\u30e4\u30fc\u30eb\uff01"},"_actorName":"\u590f\u5c14","_actorParameterID":"a4509a34-99ef-4282-98ee-b858c0da35b8","_position":{"x":167.0183,"y":854.0937},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{"_value":7},"statement":{"_text":"\u96c5\u5c14\u4e0d\u80fd\u4e0d\u53bb\u5417\u3002","_text_en":"Can\u2019t
    you not go?","_text_jp":"\u30e4\u30fc\u30eb\u3001\u884c\u304b\u306a\u3044\u3067\u3088"},"_actorName":"\u590f\u5c14","_actorParameterID":"a4509a34-99ef-4282-98ee-b858c0da35b8","_position":{"x":142.0156,"y":947.1039},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{"_value":11},"statement":{"_text":"\u590f\u5c14\u542c\u8bdd\uff0c\u4f60\u59d0\u59d0\u72af\u4e86\u9519\u5c31\u8981\u627f\u62c5\u540e\u679c\uff0c\u522b\u6253\u6405\u5979\u4e86\uff0c\u5973\u4ec6\uff0c\u628a\u5979\u5e26\u5230\u82b1\u56ed\u53bb\u73a9\u3002","_text_en":"Be
    good, Shire. Your sister made a mistake, and she needs to take responsibility.
    Don\u2019t bother her now. Maid, take her to the garden to play.","_text_jp":"\u30b7\u30e3\u30eb\u3001\u3044\u3044\u5b50\u306b\u3057\u306a\u3055\u3044\u3002\u304a\u59c9\u3055\u3093\u306f\u9593\u9055\u3044\u3092\u72af\u3057\u305f\u3089\u305d\u306e\u8cac\u4efb\u3092\u8ca0\u308f\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3002\u3082\u3046\u90aa\u9b54\u3057\u306a\u3044\u3067\u3001\u30e1\u30a4\u30c9\u304c\u5ead\u306b\u9023\u308c\u3066\u884c\u304f\u304b\u3089\u3002"},"_actorName":"\u738b","_actorParameterID":"980faa3c-7845-4377-bccf-e3425f25cfd2","_position":{"x":3.014404,"y":1053.116},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"FaceType":{},"statement":{"_text":"\u5c0f\u516c\u4e3b\uff0c\u8ddf\u6211\u8d70\u5427\u3002","_text_en":"Come
    with me, little princess.","_text_jp":"\u304a\u59eb\u69d8\u3001\u79c1\u3068\u4e00\u7dd2\u306b\u6765\u3066\u304f\u3060\u3055\u3044\u3002"},"_actorName":"\u65c1\u767d","_actorParameterID":"eee1bfb8-07cb-440e-bb22-0474cf118ce0","_position":{"x":110.0,"y":1154.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"13"},{"FaceType":{"_value":10},"statement":{"_text":"\u96c5\u5c14\u4e00\u5b9a\u8981\u65e9\u70b9\u56de\u6765\u554a!","_text_en":"Yar,
    you have to come back soon\uff01","_text_jp":"\u30e4\u30fc\u30eb\u3001\u65e9\u304f\u623b\u3063\u3066\u304d\u3066\u306d\uff01"},"_actorName":"\u590f\u5c14","_actorParameterID":"a4509a34-99ef-4282-98ee-b858c0da35b8","_position":{"x":84.0,"y":1264.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"14"},{"FaceType":{"_value":6},"statement":{"_text":"\u4e00\u5b9a!","_text_en":"I
    will!","_text_jp":"\u7d76\u5bfe\u306b\uff01"},"_actorName":"\u96c5\u5c14","_actorParameterID":"66927cc3-253f-499b-8a8d-624fd10e9374","_position":{"x":124.0,"y":1369.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"15"},{"FaceType":{},"statement":{"_text":"\u96c5\u5c14\u6ce8\u89c6\u7740\u88ab\u62c9\u8d70\u7684\u5c0f\u590f\u5c14\uff0c\u770b\u7740\u5979\u5e7c\u5c0f\u7684\u8138\u5e9e\u4e00\u6b65\u4e09\u56de\u5934\u7684\u6837\u5b50\uff0c\u5979\u5fc3\u91cc\u4e5f\u6709\u4e9b\u4e0d\u820d\uff0c\u4e0d\u8fc7\u51fa\u95e8\u7684\u597d\u5947\u5fc3\u8fd8\u662f\u80dc\u8fc7\u4e8e\u6b64\u3002","_text_en":"Yar
    watches little Shire being led away, her young face looking back again and again.
    Yaar feels a pang of sadness, but her curiosity for the journey ahead still outweighs
    it.","_text_jp":"\u30e4\u30fc\u30eb\u306f\u9023\u308c\u3066\u884c\u304b\u308c\u308b\u5c0f\u3055\u306a\u30b7\u30e3\u30eb\u3092\u898b\u3064\u3081\u308b\u3002\u5e7c\u3044\u9854\u3067\u4f55\u5ea6\u3082\u632f\u308a\u8fd4\u308b\u59ff\u306b\u540d\u6b8b\u60dc\u3057\u3055\u3092\u611f\u3058\u308b\u304c\u3001\u597d\u5947\u5fc3\u304c\u305d\u308c\u306b\u52dd\u3063\u305f\u3002"},"_actorName":"\u65c1\u767d","_actorParameterID":"eee1bfb8-07cb-440e-bb22-0474cf118ce0","_position":{"x":-18.0,"y":1469.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"16"},{"FaceType":{"_value":4},"statement":{"_text":"\u4e8b\u4e0d\u5b9c\u8fdf\u6211\u5c31\u8d76\u7d27\u51fa\u53d1\u4e86\u3002","_text_en":"No
    time to waste. I\u2019ll head out right away.","_text_jp":"\u3055\u3042\u3001\u6025\u3044\u3067\u51fa\u767a\u3057\u3088\u3046\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"66927cc3-253f-499b-8a8d-624fd10e9374","_position":{"x":64.0,"y":1563.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"17"},{"FaceType":{"_value":5},"statement":{"_text":"\u7b49\u4e0b\uff0c\u6211\u7ed9\u4f60\u4e00\u4efd\u8def\u7ebf\u56fe\u3002","_text_en":"Wait.
    I''ll give you a roadmap.","_text_jp":"\u5f85\u3066\u3001\u79c1\u306f\u3042\u306a\u305f\u306b\u8def\u7dda\u56f3\u3092\u3042\u3052\u307e\u3059\u3002"},"_actorName":"\u738b","_actorParameterID":"980faa3c-7845-4377-bccf-e3425f25cfd2","_position":{"x":3.000026,"y":1687.036},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"18"},{"_action":{"method":{"_baseInfo":"Game.GameRuntime.Entities.SceneEntities.HomeScene1.HomeScene1GoOutStoryCollider|OnHomeScene1_GetMap|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"overrideAgent":{"_type":"Game.GameRuntime.Entities.SceneEntities.HomeScene1.HomeScene1GoOutStoryCollider","_name":"HomeScene1GoOutStoryCollider","_targetVariableID":"068d266c-3404-45be-93ea-9d79edf56090"},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"},"_position":{"x":-38.12017,"y":1790.905},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"19"},{"_action":{"StoryPrefabName":{"_value":"HomeScene1GetMap"},"$type":"Game.GameRuntime.Story.Node.TriggerStoryActionTask"},"_position":{"x":43.0,"y":1885.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"20"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"4"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"4"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"5"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"6"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"7"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":