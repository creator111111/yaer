    a strange person! She even has horns!!","_text_jp":"\u5909\u306a\u4eba\uff01\u89d2\u307e\u3067\u751f\u3048\u3066\u308b\uff01\uff01"},"_actorName":"NPC2","_actorParameterID":"e123c05b-5a92-4535-8929-f9960bc49ec2","_position":{"x":200.0,"y":340.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"4"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u4e0d\u80fd\u8fd9\u4e48\u8bf4\u8bdd\uff01\u592a\u6ca1\u793c\u8c8c\u4e86\uff01","_text_en":"Don''t
    speak like that! It''s very rude!","_text_jp":"\u305d\u3093\u306a\u8a00\u3044\u65b9\u306f\u30c0\u30e1\u3088\uff01"},"_actorName":"NPC3","_actorParameterID":"d3223ff5-7c08-4bb9-ab22-07cae31192e6","_position":{"x":199.0,"y":460.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u4e0d\u597d\u610f\u601d\u6709\u4ec0\u4e48\u4e8b\u5417\uff1f","_text_en":"Sorry,
    is there something I can help you with?","_text_jp":"\u3059\u307f\u307e\u305b\u3093\u3001\u4f55\u304b\u3054\u7528\u3067\u3059\u304b\uff1f"},"_actorName":"NPC3","_actorParameterID":"d3223ff5-7c08-4bb9-ab22-07cae31192e6","_position":{"x":200.0,"y":580.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"6"},{"FaceType":{"_value":23},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u554a\u554a\u3002\u3002\u3002\u3002\u6211\u53ea\u662f\u968f\u4fbf\u8f6c\u8f6c\u3002\u3002\u3002\u3002","_text_en":"Ah...
    I was just wandering around...","_text_jp":"\u3042\u3001\u3042\u306e\u2026\u3061\u3087\u3063\u3068\u898b\u56de\u3057\u3066\u3044\u305f\u3060\u3051\u3067\u3059..."},"_actorName":"\u96c5\u5c14","_actorParameterID":"db315802-9d72-49b7-9447-6bcf7d072f3d","_position":{"x":200.0,"y":700.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"7"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u6b22\u8fce\u505a\u5ba2,\u6709\u4ef6\u4e8b\u6211\u60f3\u8bf7\u4f60\u5e2e\u5fd9\uff0c","_text_en":"Welcome.
    There''s something I''d like to ask you to help with.","_text_jp":"\u3088\u3046\u3053\u305d\u3001\u5b9f\u306f\u304a\u9858\u3044\u304c\u3042\u308b\u3093\u3067\u3059\u3002"},"_actorName":"NPC3","_actorParameterID":"d3223ff5-7c08-4bb9-ab22-07cae31192e6","_position":{"x":200.0,"y":820.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":5},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u55ef?","_text_en":"Hmm?","_text_jp":"\u3046\u3093\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"db315802-9d72-49b7-9447-6bcf7d072f3d","_position":{"x":200.0,"y":940.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u867d\u7136\u5192\u6627\u4f46\u770b\u4f60\u7684\u6837\u5b50\u5e94\u8be5\u6bd4\u6211\u4eec\u8fd9\u4e9b\u6751\u6c11\u5389\u5bb3\u591a\u4e86\uff0c\u6700\u8fd1\u6751\u5916\u602a\u7269\u8d8a\u6765\u8d8a\u591a\uff0c","_text_en":"I
    know this is sudden, but you look much stronger than the villagers. Recently,
    there have been more monsters outside.","_text_jp":"\u7a81\u7136\u304a\u9858\u3044\u3059\u308b\u306e\u306f\u5931\u793c\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c\u3001\u3042\u306a\u305f\u306e\u898b\u305f\u76ee\u304b\u3089\u3059\u308b\u3068\u3001\u6751\u306e\u4eba\u3005\u3088\u308a\u305a\u3063\u3068\u5f37\u3044\u3088\u3046\u306b\u898b\u3048\u307e\u3059\u3001\u6700\u8fd1\u3001\u6751\u306e\u5916\u306e\u30e2\u30f3\u30b9\u30bf\u30fc\u304c\u5897\u3048\u3066\u304d\u3066\u3002"},"_actorName":"NPC3","_actorParameterID":"d3223ff5-7c08-4bb9-ab22-07cae31192e6","_position":{"x":200.0,"y":1060.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u98df\u6750\u5f00\u59cb\u4e0d\u597d\u51c6\u5907\u4e86\uff0c\u4f60\u80fd\u5e2e\u6211\u4eec\u5916\u51fa\u6536\u96c6\u70b9\u85e4\u8513\u679c\u5417\uff0c\u4e94\u4e2a\u5c31\u597d\u3002","_text_en":"Food
    is getting harder to find. Could you help us collect some vine fruits, five should
    be enough.","_text_jp":"\u98df\u6750\u304c\u6e96\u5099\u3057\u3065\u3089\u304f\u306a\u3063\u3066\u304d\u305f\u3093\u3067\u3059\u3002\u5c11\u3057\u5916\u306b\u51fa\u3066\u3001\u30c4\u30eb\u306e\u5b9f\u30925\u500b\u3060\u3051\u96c6\u3081\u3066\u3044\u305f\u3060\u3051\u307e\u305b\u3093\u304b\uff1f"},"_actorName":"NPC3","_actorParameterID":"d3223ff5-7c08-4bb9-ab22-07cae31192e6","_position":{"x":200.0,"y":1180.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u6211\u4f1a\u7ed9\u4f60\u62a5\u916c\u7684\u3002","_text_en":"
    I will reward you for your help.","_text_jp":"\u5831\u916c\u3092\u3042\u3052\u307e\u3059\u3002"},"_actorName":"NPC3","_actorParameterID":"d3223ff5-7c08-4bb9-ab22-07cae31192e6","_position":{"x":200.0,"y":1300.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"availableChoices":[{"statement":{"_text":"\u6211\u6709\u4e9b\u5fd9","_text_en":"I''m
