    prophecy?","_text_jp":"\u9810\u8a00\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1866.975,"y":814.4584},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"70"},{"FaceType":{"_value":12},"statement":{"_text":"\u542c\u5976\u5976\u8bf4\u5c06\u6765\u4f1a\u6709\u4e00\u4f4d\u8eab\u7a7f\u767d\u8272\u6218\u888d\u7684\u9f99\u65cf\u5973\u795e\u89e3\u653e\u8fd9\u7247\u5927\u5730\u7684\u82e6\u96be\u3002","_text_en":"She
    says that one day, a dragon goddess dressed in white will come to free this land
    from its suffering.","_text_jp":"\u3046\u3093\u3001\u767d\u3044\u6226\u8863\u3092\u307e\u3068\u3063\u305f\u9f8d\u65cf\u306e\u5973\u795e\u69d8\u304c\u3001\u3053\u306e\u5927\u5730\u3092\u6551\u3063\u3066\u304f\u308c\u308b\u3063\u3066\u8a71\u3002"},"_actorName":"\u827e\u8389","_actorParameterID":"43f327d7-8c69-4d93-b9f9-2d2b99238cd6","_position":{"x":1843.869,"y":910.6523},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"71"},{"FaceType":{"_value":1},"statement":{"_text":"\uff08\u96be\u9053\u8bf4\u7684\u662f\u3002\u3002\u3002\u3002\u3002\u3002\u6211\u65cf\u4e00\u76f4\u4f9b\u5949\u7684\u90a3\u4f4d\u6218\u4e89\u5973\u795e\u5417\u3002\u3002\u3002\u5c06\u6765\u5979\u4f1a\u964d\u4e34\u5417\u3002\u3002\u3002\u3002\u3002\u3002\uff09","_text_en":"(Could
    it be\u2026 the war goddess our clan has always worshiped\u2026? Is she destined
    to descend in the future\u2026?)","_text_jp":"\uff08\u307e\u3055\u304b\u2026\u2026\u305d\u308c\u3063\u3066\u2026\u2026\u79c1\u305f\u3061\u304c\u305a\u3063\u3068\u7940\u3063\u3066\u304d\u305f\u6226\u306e\u5973\u795e\u69d8\uff1f\u3000\u672c\u5f53\u306b\u3044\u3064\u304b\u73fe\u308c\u308b\u306e\u2026\u2026\uff1f\uff09"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1812.975,"y":1021.458},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"72"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"38"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"4"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"4"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"5"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"6"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"7"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"9"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"9"},"_targetNode":{"$ref":"10"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"10"},"_targetNode":{"$ref":"11"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"11"},"_targetNode":{"$ref":"12"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"12"},"_targetNode":{"$ref":"13"},"$type":"NodeCanvas.DialogueTrees.DTConne