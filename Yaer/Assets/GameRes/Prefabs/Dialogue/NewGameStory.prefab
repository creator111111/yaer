--- !u!114 &8277147156603116227
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2883600314957397101}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c32e4b851ebd8fa4ea0645b99be1cf97, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _serializedExposedParameters: []
  _boundGraphSerialization: '{"type":"NodeCanvas.DialogueTrees.DialogueTree","nodes":[{"_action":{"executionMode":0,"actions":[{"HoldAfterBgVisibleSeconds":{"_value":0.5},"$type":"Game.GameRuntime.Story.Node.WaitVillageStartBgRevealActionTask"},{"canvasGroup":{"_name":"YaerPainting","_targetVariableID":"c8f0a1b2-3d4e-5f67-8901-23456789abcd"},"StartAlpha":{},"EndAlpha":{"_value":1},"Duration":{"_value":0.5},"Delay":{},"EndActionOnAnimationEnd":{"_value":true},"$type":"CanvasGroupAlphaActionTask"},{"StartAlpha":{},"EndAlpha":{"_value":1},"Duration":{"_value":0.5},"Delay":{"_value":0.5},"EndActonOnAnimationEnd":{"_value":true},"$type":"Game.GameRuntime.Story.Node.NormalDialogueUIAlphaAnimationTaskAction","PrepareMaskAvatarOnFadeIn":{"_value":false},"MaskAvatarRole":{"_value":1},"MaskAvatarFace":{"_value":6}}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":749,"y":-21},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"0"},{"FaceType":{"_value":1},"statement":{"_text":"啊啊。。虽然我以前就想说了，为什么要在拐弯处放一个这么碍事的东西啊。","_text_en":"Ugh... I''ve been meaning to say this for a while—why would anyone put something so annoying right at a corner?","_text_jp":"あああ……前から言いたかったけど、なんでこんな邪魔なものを曲がり角に置くのよ。","_audio":1},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":663.4915,"y":182.6658},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"1"},{"_action":{"parameter":{"_value":"KingMove"},"parameterHashID":{},"$type":"NodeCanvas.Tasks.Actions.MecanimSetTrigger"},"_position":{"x":1137,"y":290},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"2"},{"FaceType":{"_value":2},"statement":{"_text":"嗯!这是谁弄的!","_text_en":"Huh?! Who did this?!","_text_jp":"うむ！これは誰がやったんだ！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":787.3144,"y":309.4887},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"3"},{"FaceType":{"_value":3},"statement":{"_text":"当然是你超级无敌可爱的女儿大人了 !","_text_en":"Who else but your super ultra cute daughter, of course!","_text_jp":"もちろんスーパーウルトラかわいい娘様の私ですよ！","_audio":2},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":729.3144,"y":392.4887},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"4"},{"FaceType":{"_value":4},"statement":{"_text":"原来是我可爱的女儿，雅尔最近越来越可爱了~","_text_en":"So it was my adorable daughter—Yarl is getting cuter and cuter lately~","_text_jp":"なんと、我が愛しの娘だったか！ヤールは最近ますます可愛くなったな〜"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":730.2222,"y":483.5949},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":3},"statement":{"_text":"嗯哼~","_text_en":"Uh-huh~","_text_jp":"ふふん〜","_audio":3},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":823.2222,"y":569.5949},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"6"},{"FaceType":{"_value":5},"statement":{"_text":"啊，那个该不会是。。。。唔!这太过分了，你知道这是什么吗。","_text_en":"Ah—no way...! Ugh! That''s going too far! Do you even realize what this is?","_text_jp":"あっ、それはまさか……むっ！これはひどすぎる！これが何か分かってるのか！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":675.2222,"y":660.5949},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"7"},{"FaceType":{"_value":6},"statement":{"_text":"一堆碎块。","_text_en":"A pile of fragments","_text_jp":"一つの山になった破片。","_audio":4},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":812,"y":762},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":7},"statement":{"_text":"我是说刚才他好的时候!","_text_en":"I mean when it was intact just now!","_text_jp":"さっきまだ壊れてなかった時のことを言ってるの！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":771,"y":867},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{"_value":6},"statement":{"_text":"哎呀~坏了就再买一个吧，别生气了~","_text_en":"Oops~ Since it’s broken, just get a new one. Don’t be mad~","_text_jp":"まぁまぁ〜壊れたらまた買えばいいでしょ、そんなに怒らないで〜","_audio":5},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":739,"y":964},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{"_value":2},"statement":{"_text":"买?!卖了你都换不来一个新的!","_text_en":"Buy?! Even if I sold you, I still couldn’t get a new one!","_text_jp":"買うだと？！お前を売っても新しいのは手に入らんぞ！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":817,"y":1076},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{"_value":8},"statement":{"_text":"我这么廉价吗 !","_text_en":"Am I really that cheap?!","_text_jp":"私ってそんな安いの！？","_audio":6},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":856,"y":1195},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"FaceType":{"_value":2},"statement":{"_text":"这可是我们龙族的命脉，它的存在才让我族在这片大陆有这样的地位!","_text_en":"This is the very essence of our dragon race. Its existence is what gives our race their status on this continent!","_text_jp":"これは我ら竜族の命脈なのだ！この存在こそが我らの地位を支えているのだ！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":748,"y":1298},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"13"},{"FaceType":{"_value":8},"statement":{"_text":"既然是这么重要的东西就该给我好好收起来啊!","_text_en":"Since it’s such an important thing, you should have kept it properly!","_text_jp":"そんな大事なものなら、ちゃんとしまっておけばよかったじゃん！","_audio":7},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":777,"y":1402},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"14"},{"FaceType":{"_value":5},"statement":{"_text":"唔!!毕竟是这么荣耀的东西所以想展示出来炫耀一番才放在这的。","_text_en":"Hmm!! Since it’s something so honorable, I wanted to show it off a bit, so I placed it here.","_text_jp":"むっ！！名誉あるものだから、誇らしげに飾っておきたかったのだ。"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":718,"y":1498},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"15"},{"FaceType":{"_value":1},"statement":{"_text":"可你放在拐歪处也没什么好展示的啊。。。","_text_en":"But there’s nothing to show off by placing it at a corner like that…","_text_jp":"でも曲がり角に置いても展示にはならないってば。。。","_audio":8},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":778,"y":1595},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"16"},{"FaceType":{"_value":1},"statement":{"_text":"那现在该怎么办啊。。","_text_en":"So, what should we do now...?","_text_jp":"で、これからどうすればいいの。。。","_audio":9},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":890,"y":1642},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"17"},{"FaceType":{"_value":7},"statement":{"_text":"毕竟是独一无二的东西，也只能修复它了。","_text_en":"After all, it’s a one-of-a-kind item, so the only choice is to repair it.","_text_jp":"唯一無二のものだ、修復するしかないな。"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":814,"y":1703},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"18"},{"FaceType":{"_value":9},"statement":{"_text":"啊啊。都碎成这样了也能修复啊。","_text_en":"Ah... Even broken into pieces like this, it can still be repaired?","_text_jp":"ああ。。。こんなにバラバラでも直せるの？","_audio":10},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":897,"y":1803},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"19"},{"FaceType":{"_value":4},"statement":{"_text":"相传在这片大陆有一个叫起源之石的神奇石头，这个石头可以恢复任何东西到过去的时间，也就是说只要有了它，就能让这个复原了。","_text_en":"It is said that on this continent, there is a magical stone called the Origin Stone. This stone can restore anything back to a previous point in time.In other words, as long as you have it, you can restore this.","_text_jp":"相この大陸に「起源の石」と呼ばれる神秘の石があるという。これはすべてを元の時間に戻せる力を持っている。つまり、それさえあれば元通りにできるというわけだ。"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":836,"y":1912},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"20"},{"FaceType":{"_value":5},"statement":{"_text":"任何东西?","_text_en":"Anything?","_text_jp":"なんでも？","_audio":11},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":890.0422,"y":2022.814},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"21"},{"FaceType":{"_value":4},"statement":{"_text":"嗯嗯~~任何~东西","_text_en":"Uh-huh~~Any~thing~","_text_jp":"うむうむ~なんでも~"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":941.0422,"y":2144.814},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"22"},{"FaceType":{"_value":5},"statement":{"_text":"!!!你可不要想用在其他地方!那石头只有一次能力，用过可就没用了!","_text_en":"！！！Don’t think about using it anywhere else! That stone’s power only works once — once it’s used, it’s gone for good!","_text_jp":"！！！だが、他のことに使おうなんて考えるなよ！その石は一度きりの力しかない！使ったら終わりだ！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":918,"y":2254},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"23"},{"FaceType":{"_value":8},"statement":{"_text":"我才没想着把我的旧礼服翻新的事呢!","_text_en":"I’m definitely not thinking about using it to fix up my old dress!","_text_jp":"べ、別に古いドレスを元に戻そうなんて思ってないし！","_audio":12},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":957,"y":2362},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"24"},{"FaceType":{"_value":2},"statement":{"_text":"总之!你若是不能复原我们一族的荣耀你就别进家门了!我以龙族一主的身份命令你 !","_text_en":"n any case, if you can’t restore the honor of our clan, then don’t step foot in this house!I command you in my capacity as the head of the Dragon Clan!","_text_jp":"とにかく！我ら一族の誇りを修復できぬなら家に戻ってくるな！私は龍族の主として、お前に命じる！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":892,"y":2456},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"25"},{"FaceType":{"_value":9},"statement":{"_text":"啊啊。。是是。。那我去哪去弄石头啊。","_text_en":"Ah, alright, alright... So where am I supposed to get the stone?","_text_jp":"ああ。。。はいはい。。。で、どこでその石を手に入れればいいの？","_audio":13},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":955,"y":2558},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"26"},{"FaceType":{"_value":7},"statement":{"_text":"石头原本在魔族手里，但我们历来跟他们关系不好，不过不要紧，我听眼线讲最近它们那有盗窃发生，丢的就是这个石头，但具体在哪个人手里，就不得而知了","_text_en":"The stone originally belonged to the demon tribe, and our relations with them have always been strained. But it doesn’t matter—I heard from my spies that there was a recent theft there, and the stolen item was this stone. However, no one knows who currently holds it.","_text_jp":"石は元々魔族が持っていたが、我らとは仲が悪くてな。だが最近盗難があったらしく、盗まれたのがその石らしい。ただ、今は誰の手にあるかは不明だ。"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":873,"y":2652},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"27"},{"FaceType":{"_value":9},"statement":{"_text":"听了一句没有用的废话呢。","_text_en":"Heard a useless nonsense.","_text_jp":"なんの役にも立たない話を聞かされたわけね。","_audio":14},"_actorName":"雅尔","_actorParameterID":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_position":{"x":960,"y":2749},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"28"},{"FaceType":{"_value":2},"statement":{"_text":"好歹你知道你不用去魔族的地盘了!知道了就赶紧给我出发!","_text_en":"At least you know you don’t have to go into the demon territory!Hurry up and get going!","_text_jp":"少なくとも魔族の領土に行かなくて済むと分かっただけでもマシだろう！分かったらさっさと出発しろ！"},"_actorName":"王","_actorParameterID":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_position":{"x":888,"y":2864},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"29"},{"_action":{"SceneName":{"_value":"HomeScene1"},"EndActionOnFinishLoad":{},"$type":"Game.GameRuntime.Story.Node.LoadSceneTaskAction"},"_position":{"x":982.2493,"y":2971.601},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"30"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"4"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"4"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"5"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"6"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"7"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"9"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"9"},"_targetNode":{"$ref":"10"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"10"},"_targetNode":{"$ref":"11"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"11"},"_targetNode":{"$ref":"12"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"12"},"_targetNode":{"$ref":"13"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"13"},"_targetNode":{"$ref":"14"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"14"},"_targetNode":{"$ref":"15"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"15"},"_targetNode":{"$ref":"16"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"16"},"_targetNode":{"$ref":"17"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"17"},"_targetNode":{"$ref":"18"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"18"},"_targetNode":{"$ref":"19"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"19"},"_targetNode":{"$ref":"20"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"20"},"_targetNode":{"$ref":"21"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"21"},"_targetNode":{"$ref":"22"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"22"},"_targetNode":{"$ref":"23"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"23"},"_targetNode":{"$ref":"24"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"24"},"_targetNode":{"$ref":"25"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"25"},"_targetNode":{"$ref":"26"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"26"},"_targetNode":{"$ref":"27"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"27"},"_targetNode":{"$ref":"28"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"28"},"_targetNode":{"$ref":"29"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"29"},"_targetNode":{"$ref":"30"},"$type":"NodeCanvas.DialogueTrees.DTConnection"}],"canvasGroups":[],"localBlackboard":{"_variables":{}},"derivedData":{"actorParameters":[{"_keyName":"雅尔","_id":"49ab5f08-7fb3-49c8-8220-eacfb9100946","_actorObject":15},{"_keyName":"王","_id":"38ea5d2c-aaf2-4e22-8e12-25bd6113fad4","_actorObject":16}],"$type":"NodeCanvas.DialogueTrees.DialogueTree+DerivedSerializationData"}}'
