  _serializedExposedParameters: []
  _boundGraphSerialization: '{"type":"NodeCanvas.DialogueTrees.DialogueTree","nodes":[{"_action":{"actions":[{"gameObjectName":{"_value":"SlimeEatSheepStoryTrigger"},"saveAs":{"_name":"SlimeEatSheepStoryTrigger","_targetVariableID":"09eedc12-6f0b-4c4a-a6ca-2802b62641cd"},"$type":"NodeCanvas.Tasks.Actions.FindWithName"},{"saveComponentAs":{"_name":""},"saveGameObjectAs":{"_name":"CameraPos1","_targetVariableID":"593dd0ef-a563-4adb-8d7b-1c3dc924de96"},"$type":"NodeCanvas.Tasks.Actions.FindObjectOfType`1[[Game.GameRuntime.Entities.Player.PlayerLogic, Assembly-CSharp, Version=0.0.0.0, Culture=neutral, PublicKeyToken=null]]"},{"childName":{"_value":"CameraPos2"},"saveAs":{"_name":"CameraPos2","_targetVariableID":"40b21199-dc16-4c47-a69c-59fe853332f1"},"overrideAgent":{"_type":"UnityEngine.Transform","_name":"SlimeEatSheepStoryTrigger","_targetVariableID":"09eedc12-6f0b-4c4a-a6ca-2802b62641cd"},"$type":"NodeCanvas.Tasks.Actions.FindChildByName"},{"StartAlpha":{},"EndAlpha":{"_value":1},"Duration":{"_value":0.7},"Delay":{},"EndActonOnAnimationEnd":{},"$type":"Game.GameRuntime.Story.Node.NormalDialogueUIAlphaAnimationTaskAction"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":640,"y":-280},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"0"},{"_action":{"StartPos":{"_name":"CameraPos1","_targetVariableID":"593dd0ef-a563-4adb-8d7b-1c3dc924de96"},"EndPos":{"_name":"CameraPos2","_targetVariableID":"40b21199-dc16-4c47-a69c-59fe853332f1"},"Duration":{"_value":2.2},"$type":"Game.GameRuntime.Story.Node.CameraMoveTaskAction"},"_position":{"x":835,"y":-80},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"1"},{"_action":{"waitTime":{"_value":1},"$type":"NodeCanvas.Tasks.Actions.Wait"},"_position":{"x":833,"y":20},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"2"},{"_action":{"StartPos":{"_name":"CameraPos2","_targetVariableID":"40b21199-dc16-4c47-a69c-59fe853332f1"},"EndPos":{"_name":"CameraPos1","_targetVariableID":"593dd0ef-a563-4adb-8d7b-1c3dc924de96"},"Duration":{"_value":2.2},"$type":"Game.GameRuntime.Story.Node.CameraMoveTaskAction"},"_position":{"x":834,"y":120},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"3"},{"_action":{"isFollowPlayer":{"_value":true},"$type":"Game.GameRuntime.Story.Node.CameraFollowPlayerActionTask"},"_position":{"x":828,"y":220},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"4"},{"_action":{"StartAlpha":{},"EndAlpha":{"_value":1},"Duration":{"_value":1},"EndActonOnAnimationEnd":{"_value":true},"$type":"Game.GameRuntime.Story.Node.NormalDialogueBlackMaskTaskAction"},"_position":{"x":798,"y":820},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"5"},{"_action":{"eventArgs":{"_value":"start"},"$type":"Game.GameRuntime.Story.Node.SlimeEatSheepStoryAction2"},"_position":{"x":776,"y":920},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"6"},{"_action":{"actions":[{"StartAlpha":{},"EndAlpha":{},"Duration":{},"Delay":{},"EndActonOnAnimationEnd":{},"$type":"Game.GameRuntime.Story.Node.NormalDialogueUIAlphaAnimationTaskAction"},{"StartAlpha":{"_value":1},"EndAlpha":{},"Duration":{"_value":1},"EndActonOnAnimationEnd":{"_value":true},"$type":"Game.GameRuntime.Story.Node.NormalDialogueBlackMaskTaskAction"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":741,"y":1020},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"7"},{"FaceType":{"_value":1},"statement":{"_text":"那是。。。。","_text_en":"That''s....","_text_jp":"あれは……","_audio":1},"_actorName":"雅尔","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":780,"y":-180},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":8},"statement":{"_text":"它们居然在吃其他生物！","_text_en":"they’re eating other animals!","_text_jp":"他の生き物を食べてる！？","_audio":2},"_actorName":"雅尔","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":780,"y":320},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{},"statement":{"_text":"雅尔背后涌上一股恶寒，眼前的事物让她顿感生理不适，超出她常识的生物正在吸取一个动物尸体，莫名的诡异让她有些作呕。","_text_en":"A chill surged behind Yal, and the things in front of her made her feel physically uncomfortable. A creature beyond her common sense was sucking up an animal corpse, and the inexplicable strangeness made her feel nauseous.","_text_jp":"雅尔の背中に悪寒が走り、目の前の光景に吐き気を覚える。常識を逸脱した生物が、動物の死骸を吸収している――この異様さは彼女の理解を超えていた。"},"_actorName":"旁白","_actorParameterID":"6aa85c51-8f46-4acd-98d2-94e524ef90ce","_position":{"x":780,"y":420},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{},"statement":{"_text":"同时她也意识到这个生物十分危险","_text_en":"At the same time, she also realized that this creature was very dangerous.","_text_jp":"同時に、これが非常に危険な存在だと悟る。"},"_actorName":"旁白","_actorParameterID":"6aa85c51-8f46-4acd-98d2-94e524ef90ce","_position":{"x":780,"y":520},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{"_value":8},"statement":{"_text":"在龙城郊外居然有这么危险的东西。","_text_en":"There is such a dangerous thing in the outskirts of Longcheng.","_text_jp":"ドラゴンシティの郊外に、こんな危険なものが……","_audio":3},"_actorName":"雅尔","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":780,"y":620},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"FaceType":{"_value":8},"statement":{"_text":"想过去必须要消灭他们！","_text_en":"To get past, i must destroy them!","_text_jp":"通るには、倒すしかない！","_audio":4},"_actorName":"雅尔","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":780,"y":720},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"13"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"9"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"9"},"_targetNode":{"$ref":"10"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"10"},"_targetNode":{"$ref":"11"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"11"},"_targetNode":{"$ref":"12"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"12"},"_targetNode":{"$ref":"13"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"13"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"5"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"6"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"}],"canvasGroups":[],"localBlackboard":{"_variables":{}},"derivedData":{"actorParameters":[{"_keyName":"雅尔","_id":"3abe8617-3237-414c-bdb8-549c0134f2d0","_actorObject":5},{"_keyName":"旁白","_id":"6aa85c51-8f46-4acd-98d2-94e524ef90ce","_actorObject":6}],"$type":"NodeCanvas.DialogueTrees.DialogueTree+DerivedSerializationData"}}'
