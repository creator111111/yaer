  _serializedExposedParameters: []
  _boundGraphSerialization: '{"type":"NodeCanvas.DialogueTrees.DialogueTree","nodes":[{"_action":{"actions":[{"StartAlpha":{},"EndAlpha":{"_value":1.0},"Duration":{"_value":0.7},"Delay":{"_value":2.0},"EndActonOnAnimationEnd":{},"$type":"Game.GameRuntime.Story.Node.NormalDialogueUIAlphaAnimationTaskAction"},{"method":{"_baseInfo":"Game.GameRuntime.UI.FormLogic.Story.GoOut.GoOutMapStoryLogic|OnGetMapTips|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"overrideAgent":{"_type":"Game.GameRuntime.UI.FormLogic.Story.GoOut.GoOutMapStoryLogic","_name":"GoOutMapStoryLogic","_targetVariableID":"d277627a-941f-4016-a151-e00efcf38be3"},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":157.3137,"y":-9.055847},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"0"},{"FaceType":{"_value":11},"statement":{"_text":"\u5514\u3002\u3002\u3002\u4f60\u73b0\u5728\u51fa\u95e8\u5148\u53bb\u4eba\u7c7b\u7684\u57ce\u5e02\u5427\uff0c\u867d\u7136\u6211\u4eec\u548c\u4eba\u4e0d\u662f\u7279\u522b\u5bc6\u5207\uff0c\u4f46\u4e8b\u5173\u6211\u65cf\u547d\u8109\u4e4b\u4e8b\uff0c\u4e5f\u4e0d\u5f97\u4e0d\u53bb\u90a3\u8fb9\u6253\u542c\u60c5\u51b5\u4e86\u3002","_text_en":"Hmm\u2026
    First, head to the human city. While we don\u2019t have close ties with them,
    this concerns the lifeblood of our race\u2014we have no choice but to seek information
    there.","_text_jp":"\u3046\u30fc\u3093\u2026\u2026\u4eca\u306f\u4eba\u9593\u306e\u8857\u306b\u307e\u305a\u884c\u304f\u3093\u3060\u3002\u79c1\u305f\u3061\u306f\u4eba\u9593\u3068\u306f\u3042\u307e\u308a\u89aa\u3057\u304f\u306a\u3044\u304c\u3001\u6211\u304c\u65cf\u306e\u547d\u904b\u306b\u95a2\u308f\u308b\u3053\u3068\u3060\u304b\u3089\u3001\u305d\u3063\u3061\u3067\u60c5\u5831\u3092\u96c6\u3081\u306a\u3051\u308c\u3070\u306a\u3089\u306a\u3044\u3002"},"_actorName":"\u738b","_actorParameterID":"cf5ad60a-7bfd-4537-8895-44d907a27672","_position":{"x":62.10105,"y":104.0581},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"1"},{"FaceType":{"_value":11},"statement":{"_text":"\u5730\u56fe\u4e2d\u95f4\u90a3\u4e2a\u602a\u5f02\u5efa\u7b51\u5c31\u662f\u54af\uff0c\u5230\u4e86\u4eba\u7c7b\u57ce\u5e02\u540e\u4e00\u5b9a\u8981\u5c0f\u5fc3\u884c\u4e8b\uff0c\u4ed6\u4eec\u5bf9\u5916\u79cd\u65cf\u4e0d\u662f\u5f88\u53cb\u5584\uff0c\u5230\u4e86\u5f53\u5730\u540e\u5c31\u770b\u4f60\u81ea\u5df1\u7684\u4e86\u3002","_text_en":"That
    strange structure in the middle of the map marks the city. Be very careful when
    you arrive; humans aren\u2019t always friendly to other races. From there on,
    you\u2019ll be on your own.","_text_jp":"\u5730\u56f3\u306e\u771f\u3093\u4e2d\u306e\u5947\u5999\u306a\u5efa\u7269\u304c\u305d\u308c\u3060\u3002\u4eba\u9593\u306e\u8857\u306b\u884c\u3063\u305f\u3089\u6c17\u3092\u3064\u3051\u308b\u3093\u3060\u3088\u3002\u5f7c\u3089\u306f\u5916\u306e\u7a2e\u65cf\u306b\u3042\u307e\u308a\u53cb\u597d\u7684\u3058\u3083\u306a\u3044\u3002\u3042\u3068\u306f\u541b\u6b21\u7b2c\u3060\u3002"},"_actorName":"\u738b","_actorParameterID":"cf5ad60a-7bfd-4537-8895-44d907a27672","_position":{"x":58.0,"y":204.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"2"},{"FaceType":{"_value":1},"statement":{"_text":"\u6211\u770b\u770b~\u6211\u73b0\u5728\u5728\u54ea?","_text_en":"Let
    me see... Where am I now?","_text_jp":"\u3061\u3087\u3063\u3068\u898b\u305b\u3066\u3002\u4eca\u3069\u3053\u306b\u3044\u308b\uff1f","_audio":1},"_actorName":"\u96c5\u5c14","_actorParameterID":"8a19697c-a79e-495e-a07e-bf4595854afa","_position":{"x":169.0,"y":313.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"3"},{"_action":{"method":{"_baseInfo":"Game.GameRuntime.UI.FormLogic.Story.GoOut.GoOutMapStoryLogic|OnHomeScene1_SetSignToHome|System.Void","_paramsInfo":""},"parameters":[],"returnValue":{},"overrideAgent":{"_type":"Game.GameRuntime.UI.FormLogic.Story.GoOut.GoOutMapStoryLogic","_name":"GoOutMapStoryLogic","_targetVariableID":"d277627a-941f-4016-a151-e00efcf38be3"},"$type":"NodeCanvas.Tasks.Actions.ExecuteFunction_Multiplatform"},"_position":{"x":421.0,"y":353.0},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"4"},{"FaceType":{"_value":5},"statement":{"_text":"\u8fd9\u91cc\u3002","_text_en":"Here.","_text_jp":"\u3053\u3053\u3060\u3002"},"_actorName":"\u738b","_actorParameterID":"cf5ad60a-7bfd-4537-8895-44d907a27672","_position":{"x":172.0,"y":406.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":1},"statement":{"_text":"\u4eba\u7c7b\u57ce\u5e02\u662f?","_text_en":"And
