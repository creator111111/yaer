    there are lots of mushrooms around here.Do you like mushrooms, Yar? ","_text_jp":"\u3046\u3093\u3001\u3046\u3061\u306e\u6751\u306b\u306f\u30ad\u30ce\u30b3\u304c\u305f\u304f\u3055\u3093\u3042\u308b\u306e\u3088\u3002\u96c5\u5c14\u306f\u30ad\u30ce\u30b3\u597d\u304d\uff1f"},"_actorName":"\u53e4\u838e","_actorParameterID":"d9d67207-1573-4f04-ab40-f580581605f3","_position":{"x":381.0,"y":385.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"4"},{"FaceType":{"_value":5},"statement":{"_text":"\u6211\u5e73\u65f6\u559c\u6b22\u5403\u86cb\u7cd5\u3002","_text_en":"
    I usually like eating cake.","_text_jp":"\u666e\u6bb5\u306f\u30b1\u30fc\u30ad\u306e\u307b\u3046\u304c\u597d\u304d\u3060\u3051\u3069\u2026\u2026\u3002","_audio":2},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":409.2021,"y":491.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":6},"statement":{"_text":"\u4eca\u665a\u5c31\u53ef\u4ee5\u7ed9\u4f60\u505a\u8611\u83c7\u5927\u9910\u5c1d\u4e00\u5c1d\u4e86\u3002","_text_en":"Then
