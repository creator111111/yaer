    I can\u2019t leave here for now, so I\u2019ll help you.","_text_jp":"\u3044\u3044\u3067\u3059\u3088\u3002\u79c1\u306f\u3053\u3053\u306b\u9589\u3058\u8fbc\u3081\u3089\u308c\u3066\u3044\u3066\u3001\u3057\u3070\u3089\u304f\u51fa\u3089\u308c\u306a\u3044\u304b\u3089\u3001\u624b\u4f1d\u3063\u3066\u3042\u3052\u308b\u3088\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":360.0,"y":2020.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"19"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u4e0d\u4f1a\u8ba9\u4f60\u767d\u5fd9\u7684\uff0c\u6211\u8fd9\u91cc\u8fd8\u6709\u4e9b\u79ef\u84c4\u3002","_text_en":"I
    won\u2019t let you work for nothing, I still have some savings.","_text_jp":"\u3042\u308a\u304c\u3068\u3046\u3001\u7121\u5831\u916c\u306b\u306f\u3057\u307e\u305b\u3093\u3088\u3001\u5c11\u3057\u306e\u8caf\u91d1\u304c\u3042\u308a\u307e\u3059\u304b\u3089\u3002"},"_actorName":"\u8001\u4eba","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":360.0,"y":2140.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"20"},{"FaceType":{"_value":12},"UseShopkeeperPortrait":{},"ShopBody":{},"ShopFace":{},"UseChiefPortrait":{},"ChiefFace":{},"statement":{"_text":"\u4f60\u5e2e\u6211\u4e00\u5929\u6211\u7ed9\u4f60\u4e00\u5929\u7684\u62a5\u916c\u3002","_text_en":"If
