    have you been lately?","_text_jp":"\u6700\u8fd1\u306f\u3069\u3046\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":477.0,"y":419.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":13},"statement":{"_text":"\u611f\u8c22\u60a8\u7236\u4eb2\u7684\u5173\u7167
    \uff0c\u6211\u5f88\u597d\u3002","_text_en":"Thanks to your father\u2019s care,
    I\u2019m doing well.","_text_jp":"\u304a\u7236\u4e0a\u306e\u3054\u539a\u60c5\u306e\u304a\u304b\u3052\u3067\u3001\u79c1\u306f\u5143\u6c17\u3067\u3059\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":378.0,"y":513.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"6"},{"FaceType":{"_value":12},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":439.0,"y":616.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"7"},{"FaceType":{"_value":7},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":434.0,"y":712.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":7},"statement":{"_text":"\u90a3\u4e2a\u4f24\u8fd8\u75bc\u5417\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"Does
    that wound still hurt\u2026?","_text_jp":"\u305d\u306e\u50b7\u306f\u307e\u3060\u75db\u3080\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":382.0,"y":815.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{"_value":11},"statement":{"_text":"\u4e0d\u7528\u8fc7\u4e8e\u5173\u5fc3\u5728\u4e0b\uff0c\u6211\u7684\u547d\u662f\u60a8\u7236\u4eb2\u6551\u7684\uff0c\u5373\u4fbf\u6b7b\u4e5f\u662f\u8fd8\u6069\u3002","_text_en":"You
    don\u2019t need to worry about me. My life was saved by your father. Even if
    I die, it\u2019s just repaying a debt.","_text_jp":"\u3042\u307e\u308a\u6c17\u306b\u3057\u306a\u304f\u3066\u3044\u3044\u3002\u547d\u306f\u304a\u7236\u4e0a\u306b\u6551\u308f\u308c\u305f\u3082\u306e\u3060\u3002\u305f\u3068\u3048\u6b7b\u3093\u3067\u3082\u6069\u8fd4\u3057\u306f\u3059\u308b"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":254.0,"y":912.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{"_value":7},"statement":{"_text":"\u53ef\u90a3\u5929\u4e0d\u662f\u4f60\u5728\uff0c\u6211\u548c\u59b9\u59b9\u5c31\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"But
    if you hadn\u2019t been there that day, my sister and I would\u2019ve\u2026","_text_jp":"\u3067\u3082\u3042\u306e\u65e5\u3001\u3042\u306a\u305f\u304c\u3044\u306a\u304b\u3063\u305f\u3089\u3001\u79c1\u3068\u59b9\u306f\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":388.0,"y":1016.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u5c31\u662f\u4e3a\u4e86\u8fd9\u624d\u5b58\u5728\u7684\u3002","_text_en":"That\u2019s
    exactly why I exist.","_text_jp":"\u305d\u308c\u3053\u305d\u304c\u79c1\u306e\u5b58\u5728\u610f\u7fa9\u3060\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":359.0,"y":1112.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"FaceType":{"_value":7},"statement":{"_text":"\u83b1\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"Lai\u2026","_text_jp":"\u30e9\u30a4\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":421.0,"y":1220.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"13"},{"FaceType":{"_value":13},"statement":{"_text":"\u4eca\u5929\u51fa\u95e8\u5417\uff1f","_text_en":"Heading
    out today?","_text_jp":"\u4eca\u65e5\u306f\u5916\u51fa\u3059\u308b\u306e\u304b\uff1f"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":432.0,"y":1313.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"14"},{"FaceType":{"_value":6},"statement":{"_text":"\u5443\u3002\u554a\u3002\u662f\u554a\uff0c\u51fa\u4e86\u70b9\u5c0f\u4e8b\u3002","_text_en":"Uh,
    ah, yeah. Something came up.","_text_jp":"\u3048\u3048\u3001\u3042\u306e\u3001\u5c0f\u3055\u306a\u7528\u4e8b\u304c\u3042\u308b\u306e\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":415.0,"y":1396.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"15"},{"FaceType":{"_value":13},"statement":{"_text":"\u662f\u53c8\u80e1\u95f9\u95ef\u7978\u4e86\u5427\u3002","_text_en":"Let
    me guess\u2014you caused trouble again.","_text_jp":"\u307e\u305f\u3075\u3056\u3051\u3066\u554f\u984c\u3092\u8d77\u3053\u3057\u305f\u3093\u3060\u308d\u3046\uff1f"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":486.0,"y":1506.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"16"},{"FaceType":{"_value":6},"statement":{"_text":"\u563f\u563f\u3002\u3002\u3002\u3002\u3002\u3002\u6253\u788e\u4e86\u4e00\u4e2a\u77f3\u5934\uff0c\u7238\u7238\u4ed6\u5927\u60ca\u5c0f\u602a\u7684\u3002","_text_en":"Hehe\u2026
    I broke a stone, and Dad totally overreacted.","_text_jp":"\u3048\u3078\u3078\u2026\u77f3\u3092\u5272\u3063\u3066\u3057\u307e\u3063\u3066\u3001\u7236\u304c\u5927\u9a12\u304e\u3057\u3066\u305f\u306e\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":355.881,"y":1630.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"17"},{"FaceType":{"_value":11},"statement":{"_text":"\u90a3\u4e1c\u897f\u5bf9\u4ed6\u6765\u8bf4\u7b97\u662f\u4e00\u4e2a\u5ff5\u60f3\uff0c\u4f60\u4e0d\u80fd\u8fd9\u4e48\u8bf4\u3002","_text_en":"That
    stone holds sentimental value for him. You shouldn\u2019t speak lightly of it.","_text_jp":"\u3042\u308c\u306f\u5f7c\u306b\u3068\u3063\u3066\u601d\u3044\u5165\u308c\u306e\u3042\u308b\u3082\u306e\u3060\u304b\u3089\u3001\u8efd\u304f\u8a00\u3063\u3066\u306f\u3044\u3051\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":462.4668,"y":1741.177},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"18"},{"FaceType":{"_value":4},"statement":{"_text":"\u6211\u4e00\u76f4\u6ca1\u542c\u8fc7\u4ed6\u8bf4\u8d77\u77f3\u5934\u7684\u6765\u5386\uff0c\u53ea\u8bf4\u4e86\u90a3\u662f\u9f99\u65cf\u5f88\u91cd\u8981\u7684\u4e1c\u897f\uff0c\u662f\u8c01\u9001\u7684\u5417\u3002","_text_en":"He
    never told me where it came from. Just said it was something very important to
    the dragon clan.Was it a gift from someone?","_text_jp":"\u5f7c\u304c\u77f3\u306e\u7531\u6765\u306b\u3064\u3044\u3066\u8a71\u3057\u3066\u3044\u308b\u306e\u306f\u805e\u3044\u305f\u3053\u3068\u304c\u306a\u3044\u3002\u305f\u3060\u9f8d\u65cf\u306b\u3068\u3063\u3066\u5927\u5207\u306a\u3082\u306e\u3060\u3068\u8a00\u3063\u3066\u305f\u3051\u3069\u3001\u8ab0\u304b\u3089\u3082\u3089\u3063\u305f\u306e\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":399.5968,"y":1857.326},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"19"},{"FaceType":{"_value":14},"statement":{"_text":"\u3002\u3002\u3002\u55ef\u5475\u5475\u3002\u3002\u4ed6\u9a97\u5b69\u5b50\u5012\u662f\u6709\u4e00\u624b\u3002\u8fd9\u4e2a\u4e8b\u6211\u4e5f\u4e0d\u597d\u8ddf\u4f60\u8bb2\uff0c\u53ea\u80fd\u770b\u4ed6\u51c6\u5907\u4ec0\u4e48\u65f6\u5019\u544a\u8bc9\u4f60\u4e86\u3002","_text_en":"\u2026Haha\u2026
    He\u2019s good at keeping things from children. It\u2019s not really my place
    to tell you.\rIt\u2019s up to him to decide when to let you know.","_text_jp":"\u2026\u3046\u3093\u3001\u306f\u306f\u2026\u5f7c\u306f\u5b50\u4f9b\u306b\u5618\u3092\u3064\u304f\u306e\u304c\u3046\u307e\u3044\u3002\u3053\u306e\u3053\u3068\u306f\u79c1\u3082\u8a71\u3057\u3065\u3089\u3044\u3002\u5f7c\u304c\u3044\u3064\u8a71\u3059\u304b\u3092\u5f85\u3064\u3057\u304b\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":384.4379,"y":1983.668},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"20"},{"FaceType":{"_value":5},"statement":{"_text":"\u55ef\uff1f\u4f60\u4eec\u6709\u4e8b\u7792\u6211\uff1f","_text_en":"Huh?
    Are you two hiding something from me?","_text_jp":"\u3048\uff1f\u4f55\u304b\u96a0\u3057\u3066\u308b\u306e\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":477.0,"y":2109.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"21"},{"FaceType":{"_value":13},"statement":{"_text":"\u4e0d\u8981\u803d\u6401\u4e86\uff0c\u65e9\u70b9\u51fa\u95e8\u5427\uff0c\u4e5f\u8bb8\u7b49\u4f60\u56de\u6765\u4e86\u4ed6\u4f1a\u81ea\u5df1\u544a\u8bc9\u4f60\u3002","_text_en":"Don\u2019t
    delay any longer. You should get going. Maybe when you return, he\u2019ll tell
    you himself.","_text_jp":"\u3082\u3046\u9045\u308c\u3061\u3083\u3044\u3051\u306a\u3044\u3001\u65e9\u304f\u51fa\u304b\u3051\u305f\u307b\u3046\u304c\u3044\u3044\u3002\u623b\u3063\u305f\u3089\u5f7c\u306f\u81ea\u5206\u3067\u8a71\u3059\u304b\u3082\u3057\u308c\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":348.0,"y":2224.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"22"},{"FaceType":{"_value":4},"statement":{"_text":"\u55ef\uff0c\u83b1\u591a\u4fdd\u91cd\uff0c\u6211\u8d70\u4e86\u3002","_text_en":"Mm,
