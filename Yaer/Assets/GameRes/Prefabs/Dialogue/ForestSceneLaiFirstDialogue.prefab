    one can help him now. He has to pull himself up.","_text_jp":"\u8ab0\u306b\u3082\u624b\u52a9\u3051\u306f\u3067\u304d\u307e\u305b\u3093\u3002\u5f7c\u81ea\u8eab\u306e\u529b\u3067\u4e57\u308a\u8d8a\u3048\u308b\u3057\u304b\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":783.9906,"y":1496.885},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"38"},{"_action":{"executionMode":1,"actions":[{"setTo":1,"overrideAgent":{"_type":"UnityEngine.Transform","_name":"YaerCanvasGroup","_targetVariableID":"ffd74bbe-d7f6-4c87-91b6-f5e45c28842d"},"$type":"NodeCanvas.Tasks.Actions.SetObjectActive"},{"setTo":1,"overrideAgent":{"_type":"UnityEngine.Transform","_name":"LaiCanvasGroup","_targetVariableID":"2c30809c-f1c7-4944-bb29-dfe17aef6575"},"$type":"NodeCanvas.Tasks.Actions.SetObjectActive"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":1265.116,"y":719.2852},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"39"},{"FaceType":{"_value":12},"statement":{"_text":"\u6211\u4eec\u548c\u4eba\u7c7b\u7cbe\u7075\u540c\u76df\uff0c\u4f46\u4e0e\u4eba\u7c7b\u7684\u540c\u76df\u534f\u8bae\u5feb\u8981\u5230\u671f\u4e86\u3002","_text_en":"We\u2019re
    still allied with the humans and elves, but the treaty with the humans is about
    to expire.","_text_jp":"\u6211\u3005\u306f\u4eca\u3001\u4eba\u9593\u3068\u7cbe\u970a\u3068\u540c\u76df\u3092\u7d50\u3093\u3067\u3044\u307e\u3059\u304c\u3001\u305d\u306e\u4eba\u9593\u3068\u306e\u540c\u76df\u5354\u5b9a\u304c\u3082\u3046\u3059\u3050\u671f\u9650\u3092\u8fce\u3048\u307e\u3059\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1220.178,"y":833.6733},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"40"},{"FaceType":{"_value":12},"statement":{"_text":"\u7cbe\u7075\u6682\u4e14\u4e0d\u8bf4\uff0c\u4eba\u7c7b\u7684\u52bf\u529b\u5728\u90a3\u5e74\u5f97\u5230\u4e86\u4fdd\u5b58\u3002","_text_en":"Leaving
    aside the elves, human power was preserved that year","_text_jp":"\u7cbe\u970a\u306e\u3053\u3068\u306f\u3055\u3066\u304a\u304d\u3001\u4eba\u9593\u305f\u3061\u306f\u3042\u306e\u5e74\u3001\u6bd4\u8f03\u7684\u529b\u3092\u4fdd\u3064\u3053\u3068\u304c\u3067\u304d\u307e\u3057\u305f\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1262.178,"y":929.6733},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"41"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u4eec\u4f24\u4ea1\u60e8\u91cd\uff0c\u516b\u5e74\u6765\u4e5f\u6ca1\u80fd\u6062\u590d\u5982\u521d\u3002","_text_en":"We\u2019ve
    suffered heavy losses, and after eight years, we still haven\u2019t fully recovered.","_text_jp":"\u6211\u3005\u306f\u751a\u5927\u306a\u88ab\u5bb3\u3092\u53d7\u3051\u3001\u516b\u5e74\u7d4c\u3063\u3066\u3082\u307e\u3060\u5143\u306e\u529b\u306b\u306f\u623b\u308c\u3066\u3044\u307e\u305b\u3093\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1292.178,"y":1027.673},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"42"},{"FaceType":{"_value":11},"statement":{"_text":"\u9b54\u65cf\u7684\u52bf\u529b\u4f9d\u65e7\u5f3a\u5927\uff0c\u6709\u4f20\u8a00\u8bf4\u524d\u51e0\u4e2a\u6708\u5b83\u4eec\u53c8\u653b\u7834\u4eba\u7c7b\u8fb9\u9632\u3002","_text_en":"The
    demons are still powerful. There\u2019s word they broke through the human defenses
    again a few months back.","_text_jp":"\u9b54\u65cf\u306e\u52e2\u529b\u306f\u3044\u307e\u3060\u5065\u5728\u3067\u3001\u6570\u304b\u6708\u524d\u306b\u306f\u307e\u305f\u4eba\u9593\u306e\u56fd\u5883\u304c\u7a81\u7834\u3055\u308c\u305f\u3068\u3044\u3046\u5642\u3082\u3042\u308a\u307e\u3059\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1234.34,"y":1119.673},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"43"},{"FaceType":{"_value":7},"statement":{"_text":"\u6211\u4eec\u8be5\u600e\u4e48\u529e\uff0c\u8fd9\u573a\u6218\u4e89\u96be\u9053\u8981\u4e00\u76f4\u8fd9\u6837\u4e0b\u53bb\u5417\u3002","_text_en":"What
    are we supposed to do? Is this war going to drag on forever?","_text_jp":"\u3069\u3046\u3057\u305f\u3089\u3044\u3044\u306e\uff1f\u3053\u306e\u6226\u4e89\u3001\u305a\u3063\u3068\u7d9a\u304f\u306e\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1283.516,"y":1217.479},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"44"},{"FaceType":{"_value":11},"statement":{"_text":"\u6050\u6015\u662f\u7684\uff0c\u9b54\u65cf\u662f\u4e0d\u4f1a\u505c\u6b62\u4fb5\u7565\u7684\uff0c\u53ea\u6709\u6d88\u706d\u4ed6\u4eec\u3002","_text_en":"I\u2019m
    afraid so. The demons won\u2019t stop. We either destroy them or get destroyed.","_text_jp":"\u6050\u3089\u304f\u3001\u305d\u3046\u306a\u308b\u3067\u3057\u3087\u3046\u3002\u9b54\u65cf\u304c\u4fb5\u7565\u3092\u3084\u3081\u308b\u3053\u3068\u306f\u306a\u3044\u3002\u6ec5\u307c\u3059\u3057\u304b\u3042\u308a\u307e\u305b\u3093\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1287.516,"y":1311.479},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"45"},{"FaceType":{"_value":7},"statement":{"_text":"\u7236\u4eb2\u4e00\u8e76\u4e0d\u632f\uff0c\u6211\u4eec\u80fd\u62b5\u6321\u7684\u4f4f\u5417\u3002","_text_en":"But
    with Father like this\u2026 can we really hold the line?","_text_jp":"\u304a\u7236\u69d8\u304c\u3042\u3093\u306a\u72b6\u614b\u3067\u3001\u79c1\u305f\u3061\u3067\u5b88\u308a\u5207\u308c\u308b\u306e\u2026\u2026\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1368.516,"y":1407.479},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"46"},{"FaceType":{"_value":11},"statement":{"_text":"\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"\u2026","_text_jp":"\u2026\u2026"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1390.516,"y":1501.479},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"47"},{"FaceType":{"_value":12},"statement":{"_text":"\u4f60\u8fd8\u5c0f\uff0c\u8fd9\u79cd\u4e8b\u4ea4\u7ed9\u6211\u4eec\u5904\u7406\uff0c\u9f99\u9a91\u56e2\u6218\u58eb\u4eec\u624b\u4e2d\u7684\u5927\u5251\u4e0d\u4f1a\u8ba9\u9b54\u65cf\u518d\u8e0f\u5165\u9886\u5730\u4e00\u6b65\u3002","_text_en":"You\u2019re
    still young. Leave this to us.As long as the Dragon Riders wield their blades,
    no demon will set foot on our land.","_text_jp":"\u307e\u3060\u3042\u306a\u305f\u306f\u82e5\u3044\u3002\u3053\u306e\u3053\u3068\u306f\u6211\u3005\u306b\u4efb\u305b\u3066\u304f\u3060\u3055\u3044\u3002\u7adc\u9a0e\u56e3\u306e\u6226\u58eb\u305f\u3061\u306e\u624b\u306e\u5927\u5263\u306f\u3001\u9b54\u65cf\u3092\u518d\u3073\u9818\u5730\u306b\u8e0f\u307f\u5165\u308c\u3055\u305b\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1271.515,"y":1596.479},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"48"},{"_action":{"executionMode":1,"actions":[{"setTo":1,"overrideAgent":{"_type":"UnityEngine.Transform","_name":"YaerCanvasGroup","_targetVariableID":"ffd74bbe-d7f6-4c87-91b6-f5e45c28842d"},"$type":"NodeCanvas.Tasks.Actions.SetObjectActive"},{"setTo":1,"overrideAgent":{"_type":"UnityEngine.Transform","_name":"LaiCanvasGroup","_targetVariableID":"2c30809c-f1c7-4944-bb29-dfe17aef6575"},"$type":"NodeCanvas.Tasks.Actions.SetObjectActive"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":1699.973,"y":725.3015},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"49"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u4f1a\u602a\u6211\u5417\uff1f","_text_en":"Do
    you blame me?","_text_jp":"\u541b\u306f\u2026\u2026\u79c1\u3092\u8cac\u3081\u3066\u3044\u308b\u304b\uff1f"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1730.568,"y":837.5151},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"50"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u4f1a\u602a\u6211\u90a3\u5e74\u6ca1\u80fd\u5e26\u5979\u4e00\u8d77\u51fa\u6765\u5417\uff1f","_text_en":"Do
    you blame me for not bringing her out that day?","_text_jp":"\u3042\u306e\u5e74\u3001\u5f7c\u5973\u3092\u9023\u308c\u3066\u51fa\u308b\u3053\u3068\u304c\u3067\u304d\u306a\u304b\u3063\u305f\u79c1\u3092\u2026\u2026"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1728.29,"y":939.1879},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"51"},{"FaceType":{"_value":7},"statement":{"_text":"\u4e0d\uff0c\u867d\u7136\u6211\u90a3\u5e74\u8fd8\u5c0f\uff0c\u4f46\u6211\u4e5f\u80fd\u611f\u53d7\u5230\u5f53\u65f6\u7684\u7d27\u8feb\u3002","_text_en":"No\u2026
    I was young, but I could feel how urgent everything was.","_text_jp":"\u3044\u3044\u3048\u3002\u3042\u306e\u3068\u304d\u79c1\u306f\u5e7c\u304b\u3063\u305f\u3051\u3069\u3001\u3042\u306e\u5834\u306e\u5207\u8feb\u611f\u306f\u308f\u304b\u3063\u3066\u305f\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1746.291,"y":1051.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"52"},{"FaceType":{"_value":7},"statement":{"_text":"\u4f60\u80fd\u628a\u6211\u548c\u59b9\u59b9\u6551\u51fa\u6211\u4eec\u5df2\u7ecf\u5f88\u611f\u6fc0\u4e86\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"You
    saved me and my sister. We are already very grateful\u2026","_text_jp":"\u3042\u306a\u305f\u304c\u79c1\u3068\u59b9\u3092\u52a9\u3051\u51fa\u3057\u3066\u304f\u308c\u305f\u3060\u3051\u3067\u3001\u672c\u5f53\u306b\u611f\u8b1d\u3057\u3066\u308b\u2026\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1754.078,"y":1144.892},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"53"},{"FaceType":{"_value":7},"statement":{"_text":"\u600e\u4e48\u53ef\u80fd\u8fd8\u4f1a\u602a\u4f60\u3002","_text_en":"How
    could we possibly blame you?","_text_jp":"\u8cac\u3081\u308b\u306a\u3093\u3066\u3001\u3042\u308a\u5f97\u306a\u3044\u3088\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1817.728,"y":1239.464},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"54"},{"FaceType":{"_value":11},"statement":{"_text":"\u4f60\u7684\u6bcd\u4eb2\u662f\u4e2a\u4f1f\u5927\u7684\u4eba\u3002","_text_en":"Your
    mother was a great woman.","_text_jp":"\u3042\u306a\u305f\u306e\u6bcd\u4e0a\u306f\u3001\u5049\u5927\u306a\u65b9\u3060\u3063\u305f\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1756.29,"y":1359.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"55"},{"FaceType":{"_value":11},"statement":{"_text":"\u90a3\u5e74\u5979\u628a\u4f60\u548c\u590f\u5c14\u6258\u4ed8\u7ed9\u6211\uff0c\u6211\u770b\u5230\u4e86\u5979\u7684\u8138\u3002","_text_en":"That
    day, when she entrusted you and Shire to me\u2026 I saw her face.","_text_jp":"\u3042\u306e\u65e5\u3001\u3042\u306a\u305f\u3068\u30b7\u30e3\u30eb\u3092\u79c1\u306b\u8a17\u3057\u3066\u3001\u5f7c\u5973\u306e\u8868\u60c5\u3092\u898b\u305f\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1739.29,"y":1459.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"56"},{"FaceType":{"_value":11},"statement":{"_text":"\u90a3\u662f\u5979\u5e73\u65e5\u91cc\u4ece\u672a\u6d41\u9732\u8fc7\u7684\u8868\u60c5\u3002","_text_en":"A
    look I had never seen on her before.","_text_jp":"\u305d\u308c\u306f\u3001\u666e\u6bb5\u306e\u5f7c\u5973\u304b\u3089\u306f\u8003\u3048\u3089\u308c\u306a\u3044\u3001\u899a\u609f\u306b\u6e80\u3061\u305f\u9854\u3060\u3063\u305f\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1773.29,"y":1554.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"57"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u60f3\u5979\u5f53\u65f6\u5df2\u7ecf\u505a\u597d\u4e86\u89c9\u609f\u3002","_text_en":"I
    think she already knew what was coming.","_text_jp":"\u5f7c\u5973\u306f\u3042\u306e\u6642\u3001\u3059\u3067\u306b\u899a\u609f\u3092\u6c7a\u3081\u3066\u3044\u305f\u306e\u3060\u3068\u601d\u3044\u307e\u3059\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1790.29,"y":1647.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"58"},{"FaceType":{"_value":7},"statement":{"_text":"\u545c\u545c\u545c\u545c\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"[soft
    sobbing]","_text_jp":"\u3046\u3046\u3046\u3046\u2026\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":1819.315,"y":1750.813},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"59"},{"FaceType":{"_value":15},"statement":{"_text":"\u96c5\u5c14\uff0c\u4f60\u5fc5\u987b\u575a\u5f3a\u8d77\u6765\uff0c\u4f60\u548c\u4f60\u59b9\u59b9\u80a9\u8d1f\u7740\u91cd\u62c5\u3002","_text_en":"Yar,
    you must stay strong. You and your sister have a great burden to carry.","_text_jp":"\u96c5\u30eb\u3001\u5f37\u304f\u306a\u308b\u3093\u3060\u3002\u541b\u3068\u59b9\u306b\u306f\u5927\u304d\u306a\u8cac\u4efb\u304c\u3042\u308b\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1721.29,"y":1850.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"60"},{"FaceType":{"_value":15},"statement":{"_text":"\u8fd9\u4e9b\u4eba\u7684\u6b7b\u4e0d\u80fd\u6789\u8d39\uff01","_text_en":"Their
    deaths must not be in vain!","_text_jp":"\u5f7c\u3089\u306e\u72a0\u7272\u3092\u7121\u99c4\u306b\u306f\u3067\u304d\u306a\u3044\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1779.29,"y":1948.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"61"},{"FaceType":{"_value":15},"statement":{"_text":"\u6211\u548c\u4f60\u7236\u4eb2\u5b9a\u8981\u8ba9\u8fd9\u5e2e\u4eba\u4ed8\u51fa\u4ee3\u4ef7\uff01","_text_en":"Your
    father and I will make them pay!","_text_jp":"\u79c1\u3068\u3042\u306a\u305f\u306e\u7236\u4e0a\u306f\u3001\u3042\u306e\u8005\u305f\u3061\u306b\u5fc5\u305a\u5831\u3044\u3092\u53d7\u3051\u3055\u305b\u308b\uff01"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":1733.29,"y":2049.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"62"},{"_action":{"executionMode":1,"actions":[{"setTo":1,"overrideAgent":{"_type":"UnityEngine.Transform","_name":"YaerCanvasGroup","_targetVariableID":"ffd74bbe-d7f6-4c87-91b6-f5e45c28842d"},"$type":"NodeCanvas.Tasks.Actions.SetObjectActive"},{"setTo":1,"overrideAgent":{"_type":"UnityEngine.Transform","_name":"LaiCanvasGroup","_targetVariableID":"2c30809c-f1c7-4944-bb29-dfe17aef6575"},"$type":"NodeCanvas.Tasks.Actions.SetObjectActive"}],"$type":"NodeCanvas.Framework.ActionList"},"_position":{"x":2091.597,"y":676.3383},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"63"},{"FaceType":{"_value":12},"statement":{"_text":"\u6211\u5e74\u8f7b\u7684\u65f6\u5019\u5728\u90a3\u9644\u8fd1\u751f\u6d3b\u8fc7\u4e00\u9635\u5b50\u3002","_text_en":"I
    lived around there for a while when I was younger.","_text_jp":"\u82e5\u3044\u3053\u308d\u3001\u5c11\u3057\u3060\u3051\u305d\u306e\u8fd1\u304f\u3067\u751f\u6d3b\u3057\u305f\u3053\u3068\u304c\u3042\u308b\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":2044.578,"y":811.6949},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"64"},{"FaceType":{"_value":5},"statement":{"_text":"\u554a\uff0c\u83b1\u4f60\u8fd8\u548c\u4eba\u7c7b\u6253\u8fc7\u4ea4\u9053\u5462\u3002","_text_en":"Wow,
    so you\u2019ve actually dealt with humans?","_text_jp":"\u30e9\u30a4\u3001\u4eba\u9593\u3068\u95a2\u308f\u3063\u305f\u3053\u3068\u304c\u3042\u308b\u3093\u3060\u306d\u3002"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":2122.292,"y":918.1877},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"65"},{"FaceType":{"_value":12},"statement":{"_text":"\u6ca1\u6709\u592a\u6df1\u4ea4\uff0c\u6211\u4e0d\u662f\u4e2a\u559c\u6b22\u4ea4\u6d41\u7684\u4eba\u3002","_text_en":"Not
    deeply. I\u2019m not one for chatting.","_text_jp":"\u6df1\u304f\u4ed8\u304d\u5408\u3063\u305f\u308f\u3051\u3058\u3083\u306a\u3044\u3002\u4ffa\u306f\u3042\u307e\u308a\u4eba\u4ed8\u304d\u5408\u3044\u304c\u5f97\u610f\u3058\u3083\u306a\u3044\u304b\u3089\u306a\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":2147.579,"y":1008.695},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"66"},{"FaceType":{"_value":4},"statement":{"_text":"\u4ed6\u4eec\u597d\u76f8\u5904\u5417\uff1f","_text_en":"Are
    they easy to get along with?","_text_jp":"\u4eba\u9593\u3063\u3066\u3001\u4ed8\u304d\u5408\u3044\u3084\u3059\u3044\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":2181.292,"y":1103.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"67"},{"FaceType":{"_value":12},"statement":{"_text":"\u4ed6\u4eec\u5f88\u590d\u6742\u3002","_text_en":"They\u2019re
    complicated.","_text_jp":"\u5f7c\u3089\u306f\u8907\u96d1\u3060\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":2147.579,"y":1205.695},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"68"},{"FaceType":{"_value":4},"statement":{"_text":"\u4ec0\u4e48\u610f\u601d\uff1f","_text_en":"What
    do you mean?","_text_jp":"\u3069\u3046\u3044\u3046\u610f\u5473\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":2166.292,"y":1306.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"69"},{"FaceType":{"_value":11},"statement":{"_text":"\u53ea\u8a00\u7247\u8bed\u8bf4\u4e0d\u6e05\uff0c\u5982\u679c\u4f60\u8981\u53bb\u90a3\u8fb9\uff0c\u5c0f\u5fc3\u5f53\u5730\u4eba\uff0c\u4e0d\u8981\u8f7b\u4fe1\u4ed6\u4eec\u7684\u8bdd\u3002","_text_en":"Hard
    to explain in a few words. If you''re going there, be careful. Don\u2019t trust
    what they say too easily.","_text_jp":"\u4e00\u8a00\u3067\u306f\u8a00\u3048\u306a\u3044\u3002\u3082\u3057\u541b\u304c\u5411\u3053\u3046\u306b\u884c\u304f\u306a\u3089\u3001\u5730\u5143\u306e\u4eba\u9593\u306b\u306f\u6c17\u3092\u3064\u3051\u308d\u3002\u8efd\u3005\u3057\u304f\u4fe1\u3058\u3066\u306f\u306a\u3089\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":2133.579,"y":1406.695},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"70"},{"FaceType":{"_value":5},"statement":{"_text":"\u8fd9\u4e48\u4e25\u8083\u5417\uff1f","_text_en":"Is
    it that serious?","_text_jp":"\u305d\u3093\u306a\u306b\u53b3\u91cd\u306a\u306e\u2026\u2026\uff1f"},"_actorName":"\u96c5\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":2243.292,"y":1518.188},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"71"},{"FaceType":{"_value":11},"statement":{"_text":"\u6211\u4e0d\u5e0c\u671b\u4f60\u4e5f\u9047\u5230\u6211\u8eab\u4e0a\u7684\u4e8b\u3002","_text_en":"I
    don\u2019t want the same thing to happen to you.","_text_jp":"\u541b\u306b\u306f\u3001\u79c1\u3068\u540c\u3058\u76ee\u306b\u906d\u3063\u3066\u307b\u3057\u304f\u306a\u3044\u3002"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":2160.579,"y":1609.695},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"72"},{"FaceType":{"_value":6},"statement":{"_text":"\u90a3\uff0c\u7b49\u6211\u56de\u6765\uff0c\u6211\u5e26\u793c\u7269\u56de\u6765\u9001\u4f60","_text_en":"Then,
