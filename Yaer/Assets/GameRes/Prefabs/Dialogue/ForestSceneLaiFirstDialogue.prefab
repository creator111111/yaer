    my eyes, he''s always been a dependable man.","_text_jp":"\u5f7c\u306f\u305a\u3063\u3068\u3001\u79c1\u306b\u3068\u3063\u3066\u983c\u308a\u306b\u306a\u308b\u7537\u3067\u3059"},"_actorName":"\u83b1","_actorParameterID":"e0fe1e77-a465-4f74-af9a-c46c432ecab0","_position":{"x":753.9906,"y":977.8853},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"33"},{"FaceType":{"_value":7},"statement":{"_text":"\u4ed6\u73b0\u5728\u3002\u3002\u3002\u3002\u3002\u3002","_text_en":"And
