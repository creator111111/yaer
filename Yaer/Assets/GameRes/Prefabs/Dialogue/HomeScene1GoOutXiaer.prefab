    you miss me, just look at it and you won\u2019t miss me anymore!","_text_jp":"\u30e4\u30fc\u30eb\u304c\u50d5\u306e\u3053\u3068\u601d\u3044\u51fa\u3057\u305f\u3089\u3001\u305d\u308c\u3092\u898b\u308c\u3070\u5bc2\u3057\u304f\u306a\u3044\u3088\uff01"},"_actorName":"\u590f\u5c14","_actorParameterID":"3abe8617-3237-414c-bdb8-549c0134f2d0","_position":{"x":365.0,"y":408.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"4"},{"FaceType":{"_value":1},"statement":{"_text":"\u3002\u3002\u3002\u3002","_text_en":"\u2026","_text_jp":"\u2026\u2026\u2026"},"_actorName":"\u96c5\u5c14","_actorParameterID":"f4ac873c-c968-4792-8b08-05e690ebcbe2","_position":{"x":409.0,"y":499.0},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":6},"statement":{"_text":"\u8c22\u8c22\uff0c\u90a3\u6211\u5c31\u51fa\u53d1\u4e86\u3002","_text_en":"Thank
