  m_EditorClassIdentifier: 
  _serializedGraph: '{"type":"NodeCanvas.DialogueTrees.DialogueTree","nodes":[{"_action":{"StartAlpha":{},"EndAlpha":{"_value":1},"Duration":{"_value":1},"Delay":{},"EndActonOnAnimationEnd":{"_value":true},"PrepareMaskAvatarOnFadeIn":{},"MaskAvatarRole":{},"MaskAvatarFace":{},"$type":"Game.GameRuntime.Story.Node.NormalDialogueUIAlphaAnimationTaskAction"},"_position":{"x":200,"y":-20},"$type":"NodeCanvas.DialogueTrees.ActionNode","$id":"0"},{"FaceType":{"_value":5},"statement":{"_text":"好大的一片田。"},"_actorName":"雅尔","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":200,"y":100},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"1"},{"FaceType":{"_value":12},"statement":{"_text":"没见过你，你从哪来？"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":220},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"2"},{"FaceType":{"_value":4},"statement":{"_text":"我是途径此地的，暂时住在这里。"},"_actorName":"雅尔","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":200,"y":340},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"3"},{"FaceType":{"_value":12},"statement":{"_text":"好多年没见过生面孔了。"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":460},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"4"},{"FaceType":{"_value":12},"statement":{"_text":"唉。。。。。。"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":580},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"5"},{"FaceType":{"_value":4},"statement":{"_text":"村里的很多人都愁眉苦脸的。"},"_actorName":"雅尔","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":200,"y":700},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"6"},{"FaceType":{"_value":12},"statement":{"_text":"有的失去了亲人，有的担忧未来。"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":820},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"7"},{"FaceType":{"_value":7},"statement":{"_text":"那你呢？"},"_actorName":"雅尔","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":200,"y":940},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"8"},{"FaceType":{"_value":12},"statement":{"_text":"我就是干累了，腰疼。"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":1060},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"9"},{"FaceType":{"_value":9},"statement":{"_text":"啊哈哈哈哈。。。。。。"},"_actorName":"雅尔","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":200,"y":1180},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"10"},{"FaceType":{"_value":12},"statement":{"_text":"你有时间吗？"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":1300},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"11"},{"FaceType":{"_value":4},"statement":{"_text":"嗯？"},"_actorName":"雅尔","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":200,"y":1420},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"12"},{"FaceType":{"_value":12},"statement":{"_text":"我想也许你能帮我点忙。"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":1540},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"13"},{"FaceType":{"_value":4},"statement":{"_text":"什么事？"},"_actorName":"雅尔","_actorParameterID":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_position":{"x":200,"y":1660},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"14"},{"FaceType":{"_value":12},"statement":{"_text":"我要去水井打水，有点远，我老伴走的早，你能帮我打几桶水浇地吗。"},"_actorName":"老人","_actorParameterID":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_position":{"x":200,"y":1780},"$type":"Game.GameRuntime.Story.NodeCanvasExtend.StatementNodeEx","$id":"15"}],"connections":[{"_sourceNode":{"$ref":"0"},"_targetNode":{"$ref":"1"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"1"},"_targetNode":{"$ref":"2"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"2"},"_targetNode":{"$ref":"3"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"3"},"_targetNode":{"$ref":"4"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"4"},"_targetNode":{"$ref":"5"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"5"},"_targetNode":{"$ref":"6"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"6"},"_targetNode":{"$ref":"7"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"7"},"_targetNode":{"$ref":"8"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"8"},"_targetNode":{"$ref":"9"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"9"},"_targetNode":{"$ref":"10"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"10"},"_targetNode":{"$ref":"11"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"11"},"_targetNode":{"$ref":"12"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"12"},"_targetNode":{"$ref":"13"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"13"},"_targetNode":{"$ref":"14"},"$type":"NodeCanvas.DialogueTrees.DTConnection"},{"_sourceNode":{"$ref":"14"},"_targetNode":{"$ref":"15"},"$type":"NodeCanvas.DialogueTrees.DTConnection"}],"canvasGroups":[],"localBlackboard":{"_variables":{}},"derivedData":{"actorParameters":[{"_keyName":"老人","_id":"b2c3d4e5-f6a7-4890-b123-456789abcdef","_actorObject":1},{"_keyName":"雅尔","_id":"a1b2c3d4-e5f6-4789-a012-3456789abcde","_actorObject":2}],"$type":"NodeCanvas.DialogueTre